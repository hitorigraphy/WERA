<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wera.Core\Wera.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 기본 게임팩은 samples/ 한 곳에서만 관리하고 배포 시 사이트 루트에 포함한다 -->
    <Content Include="../../samples/sample-pack.zip" Link="wwwroot/sample-pack.zip" />
  </ItemGroup>

</Project>
