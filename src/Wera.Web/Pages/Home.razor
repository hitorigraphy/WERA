@page "/"
@using System.Text
@using Wera.Core
@inject IJSRuntime JS

<PageTitle>@(pack?.Title ?? "WERA")</PageTitle>

@{
    RenderFragment commands = @<div class="commands">
        @foreach (var entry in session!.Entries)
        {
            var code = entry.Code;
            <div><button class="textlink" @onclick="() => Activate(code)">[@entry.Code] @entry.Label</button></div>
        }
        <input @ref="commandInput" class="command" autocomplete="off" placeholder="코드를 입력하고 Enter"
               @bind="command" @bind:event="oninput" @onkeydown="OnCommandKey" />
    </div>;
}

<main>
    @if (pack is null)
    {
        <div class="drop" @ondragenter="() => dragging = true" @ondragleave="() => dragging = false" @ondrop="() => dragging = false"
             data-dragging="@dragging">
            <p>게임팩(.zip)을 여기에 끌어다 놓으세요</p>
            <InputFile OnChange="OnPackSelected" accept=".zip" />
        </div>
    }
    else if (session is null)
    {
        <h1>@pack.Title</h1>
        <button @onclick="NewGame">새 게임</button>
        <div class="drop" @ondragenter="() => dragging = true" @ondragleave="() => dragging = false" @ondrop="() => dragging = false"
             data-dragging="@dragging">
            <p>세이브(.sav)를 여기에 끌어다 놓으세요</p>
            <InputFile OnChange="OnSaveSelected" accept=".sav,.json" />
        </div>
    }
    else
    {
        @switch (session.Screen)
        {
            case Screen.Home:
                <h1>@pack.Title</h1>
                @commands
                break;

            case Screen.DungeonSelect:
                <h2>던전 선택</h2>
                <ul class="dungeons">
                    @foreach (var d in session.AvailableDungeons)
                    {
                        <li>[@d.Code] @d.Name</li>
                    }
                </ul>
                @commands
                break;

            case Screen.ShopList:
                <h2>상점가</h2>
                @commands
                break;

            case Screen.ShopTrades:
                <h2>@session.CurrentShop?.Name</h2>
                @if (session.CurrentShopTrades.Count == 0)
                {
                    <p class="end">교환할 수 있는 항목이 없습니다.</p>
                }
                @if (session.Message is not null)
                {
                    <p class="message" role="status">@session.Message</p>
                }
                @commands
                break;

            case Screen.Load:
                <h2>로드</h2>
                <div class="drop" @ondragenter="() => dragging = true" @ondragleave="() => dragging = false" @ondrop="() => dragging = false"
                     data-dragging="@dragging">
                    <p>세이브(.sav)를 여기에 끌어다 놓으세요</p>
                    <InputFile OnChange="OnSaveSelected" accept=".sav,.json" />
                </div>
                @commands
                break;

            default:
                <p class="scene">@session.Current.Text</p>
                <ul class="choices">
                    @for (var i = 0; i < session.Current.Choices.Count; i++)
                    {
                        var index = i;
                        <li><button @onclick="() => Choose(index)">@session.Current.Choices[index].Label</button></li>
                    }
                </ul>
                @if (session.Current.Choices.Count == 0)
                {
                    <p class="end">— 끝 —</p>
                }
                break;
        }
        <footer>
            <button @onclick="SaveGame">세이브 저장</button>
            <button @onclick="Quit">게임팩 다시 고르기</button>
        </footer>
    }

    @if (error is not null)
    {
        <p class="error" role="alert">@error</p>
    }
</main>

@code {
    const long MaxBytes = 2L * 1024 * 1024 * 1024 - 1;

    GamePack? pack;
    GameSession? session;
    string? error;
    bool dragging;
    string command = "";
    ElementReference commandInput;
    bool focusCommand;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!focusCommand) return;
        focusCommand = false;
        if (session is { Entries.Count: > 0 } or { Screen: Screen.DungeonSelect })
            await commandInput.FocusAsync();
    }

    async Task OnPackSelected(InputFileChangeEventArgs e)
    {
        error = null;
        try
        {
            var ms = new MemoryStream();
            await using (var s = e.File.OpenReadStream(MaxBytes)) await s.CopyToAsync(ms);
            ms.Position = 0;
            pack = GamePack.Load(ms);
        }
        catch (Exception ex) when (ex is PackFormatException or InvalidDataException)
        {
            error = ex is PackFormatException ? ex.Message : "zip 파일을 읽을 수 없습니다.";
        }
    }

    async Task OnSaveSelected(InputFileChangeEventArgs e)
    {
        error = null;
        try
        {
            using var reader = new StreamReader(e.File.OpenReadStream(16 * 1024 * 1024), Encoding.UTF8);
            session = GameSession.FromSaveJson(pack!, await reader.ReadToEndAsync());
            focusCommand = true;
        }
        catch (SaveFormatException ex) { error = ex.Message; }
    }

    void NewGame() { error = null; session = GameSession.NewGame(pack!); focusCommand = true; }

    void Choose(int index) => session!.Choose(index);

    async Task Activate(string code)
    {
        error = null;
        var entry = session!.Activate(code);
        if (entry is null) error = $"알 수 없는 입력: {code}";
        else if (entry.Action == EntryAction.Save) await SaveGame();
        command = "";
        focusCommand = true;
    }

    async Task OnCommandKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Activate(command);
    }

    async Task SaveGame() =>
        await JS.InvokeVoidAsync("wera.download", $"{pack!.Id}.sav", session!.ToSaveJson());

    void Quit() { pack = null; session = null; error = null; command = ""; }
}
