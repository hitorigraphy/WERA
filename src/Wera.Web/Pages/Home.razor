@page "/"
@using System.Text
@using Wera.Core
@inject IJSRuntime JS
@inject HttpClient Http

<PageTitle>@(pack?.Title ?? "WERA")</PageTitle>

@{
    // 클릭 가능한 텍스트 목록. 항목마다 [코드]가 붙고, 그 코드를 입력해도 같은 동작을 한다.
    // [999] 돌아가기는 목록에 넣지 않는다: 모든 화면에서 같은 자리(코드 입력줄 바로 위 오른쪽)에 따로 나온다.
    RenderFragment<IEnumerable<ScreenEntry>> entryList = entries => @<div class="entries">
        @foreach (var entry in entries.Where(e => e.Code != GameSession.BackEntryCode))
        {
            var code = entry.Code;
            <div><button class="textlink" disabled="@(!entry.Enabled)" @onclick="() => Activate(code)">[@entry.Code] @if (entry.LabelHtml is { } html) { @((MarkupString)html) } else { @entry.Label }</button></div>
        }
    </div>;

    // 파티 설정 화면 아래: 구분선, 파티 선택 버튼([11] 파티-A ~ [26] 파티-P, 한 줄에 4개씩), 모드 버튼([101] 캐릭터 배치, [102] 장비 착용)을 4분할 위치에 가로로.
    // 지금 보는 파티와 지금 모드의 버튼은 파란색으로 눌리지 않고, 고를 수 있는 다른 것은 흰색이다.
    RenderFragment partyCommands = @<div class="party-commands">
        <div class="party-select">@entryList(session!.Entries.Where(e => e.Action == EntryAction.SelectParty))</div>
        <div class="party-modes">@entryList(session!.Entries.Where(e => e.Action == EntryAction.Navigate && e.Arg is null && e.Target != Screen.Home))</div>
    </div>;

    // 파티 설정 화면 제목의 "[0] 파티명": 누르면(또는 0을 입력하면) 파티 이름을 바꾼다.
    RenderFragment partyNameButton = @<button class="textlink" @onclick="() => Activate(GameSession.RenamePartyEntryCode)">[@GameSession.RenamePartyEntryCode] @session!.PartyName</button>;

    RenderFragment commands = @<div class="commands">
        @entryList(session!.Entries)
    </div>;

    // 속성 아이콘 이미지 리소스가 없을 때(지금은 항상) 쓰는 1줄 높이의 작은 기본 이미지.
    RenderFragment noImageSmall = @<svg class="badge-icon" viewBox="0 0 10 10" role="img" aria-label="No Image">
        <rect x="0.5" y="0.5" width="9" height="9" fill="#000" stroke="#666" />
    </svg>;

    // 캐릭터 이미지 리소스가 없을 때(지금은 항상) 쓰는 기본 이미지.
    RenderFragment noImage = @<svg class="no-image" viewBox="0 0 100 100" role="img" aria-label="No Image">
        <rect x="1" y="1" width="98" height="98" fill="#000" stroke="#666" stroke-width="2" />
        <text x="50" y="55" text-anchor="middle" font-size="15" fill="#999" font-family="monospace">No Image</text>
    </svg>;

    // 홈 화면 위쪽의 슬롯(당신, 파트너, 어시스트): 파티 슬롯과 같은 모양. 코드가 있으면 이미지나 이름을 눌러(또는 그 코드를 입력해)
    // 캐릭터 목록으로 가고, 코드가 없으면(당신) 눌러도 아무 일도 없다.
    RenderFragment<(PartySlotView View, string? Code)> homeSlot = item => @<div class="slot">
        @if (item.Code is { } homeCode)
        {
            <button class="slot-icon" title="@item.View.Name" @onclick="() => Activate(homeCode)">@noImage</button>
        }
        else
        {
            <div class="slot-icon" title="@item.View.Name">@noImage</div>
        }
        <div class="slot-info">
            @if (item.Code is { } nameCode)
            {
                <button class="@SlotNameClass(item.View)" @onclick="() => Activate(nameCode)">
                    <span class="slot-level">@item.View.LevelText</span><span class="slot-char">@item.View.Name</span>
                </button>
            }
            else
            {
                <div class="@SlotNameClass(item.View)"><span class="slot-level">@item.View.LevelText</span><span class="slot-char">@item.View.Name</span></div>
            }
            <div class="gauge-line">HP : <span class="gauge gauge-@item.View.Hp.Color.ToString().ToLowerInvariant()">@item.View.Hp.Text</span></div>
            <div class="gauge-line">XP : <span class="gauge gauge-@item.View.Xp.Color.ToString().ToLowerInvariant()">@item.View.Xp.Text</span></div>
            <div class="icon-line">
                <span class="icons-left">
                    @foreach (var badge in item.View.Badges)
                    {
                        <span class="badge" title="@badge.Name (@(badge.Advantage ? "유리속성" : "불리속성"))">@noImageSmall<span class="badge-marker">@badge.Marker</span></span>
                    }
                </span>
                <span class="icons-right">
                    @foreach (var status in item.View.StatusBadges)
                    {
                        <span class="badge" title="@status.Name (상태이상)">@noImageSmall</span>
                    }
                </span>
            </div>
        </div>
    </div>;

    // 당신, 파트너, 어시스트 슬롯 줄(홈 화면과 교류 화면 위쪽). 눌러서 바꿀 수 있는 것은 홈 화면뿐이라 교류 화면에서는 interactive가 false다.
    RenderFragment<bool> homeSlots = interactive => @<div class="home-slots">
        <div>
            <div class="row-label">@GameSession.PlayerSlotName</div>
            @homeSlot((session!.PlayerSlot, null))
        </div>
        <div>
            <div class="row-label">@(interactive ? $"[{GameSession.PartnerEntryCode}] " : "")파트너</div>
            @homeSlot((session!.PartnerSlot, interactive ? GameSession.PartnerEntryCode : null))
        </div>
        <div>
            <div class="row-label">@(interactive ? $"[{GameSession.AssistEntryCode}] " : "")어시스트</div>
            @homeSlot((session!.AssistSlot, interactive ? GameSession.AssistEntryCode : null))
        </div>
    </div>;

    // 파티 슬롯 3×3. 위 줄이 전위, 가운데 줄이 중위, 아래 줄이 후위. 이름이나 아이콘을 누르면(또는 슬롯 번호를 입력하면)
    // 캐릭터 배치 모드에서는 배치할 캐릭터 목록으로, 장비 착용 모드에서는 그 캐릭터의 장비 목록으로 간다.
    // 장비 착용 모드에서는 빈 슬롯을 누를 수 없다.
    RenderFragment<bool> partyGrid = equipmentMode => @<div class="party-grid">
        @foreach (var slot in session!.PartySlotViews)
        {
            var slotCode = (slot.Slot + 1).ToString();
            var enabled = session.Entries.Any(e => e.Code == slotCode && e.Enabled);      // 화면마다 고를 수 있는 슬롯이 다르다
            @if (slot.Slot % 3 == 0)
            {
                <div class="row-label">@slot.RowName</div>
            }
            <div class="slot" data-slot="@slotCode">
                <button class="slot-icon" title="@slot.Name" disabled="@(!enabled)" @onclick="() => Activate(slotCode)">@noImage</button>
                <div class="slot-info">
                    @* "Lv.XX            [x] 이름"(레벨은 왼쪽, "[x] 이름"은 줄 오른쪽 끝; 빈 슬롯은 레벨 자리가 빔): [x]는 슬롯 번호이고 입력해도 고를 수 있다 *@
                    <button class="@(slot.IsLeader ? "slot-name leader" : "slot-name")" disabled="@(!enabled)" @onclick="() => Activate(slotCode)">
                        <span class="slot-level">@slot.LevelText</span><span class="slot-char">[@slotCode] @slot.Name</span>
                    </button>
                    <div class="gauge-line">HP : <span class="gauge gauge-@slot.Hp.Color.ToString().ToLowerInvariant()">@slot.Hp.Text</span></div>
                    <div class="gauge-line">XP : <span class="gauge gauge-@slot.Xp.Color.ToString().ToLowerInvariant()">@slot.Xp.Text</span></div>
                    <div class="icon-line">
                        <span class="icons-left">
                            @foreach (var badge in slot.Badges)
                            {
                                <span class="badge" title="@badge.Name (@(badge.Advantage ? "유리속성" : "불리속성"))">@noImageSmall<span class="badge-marker">@badge.Marker</span></span>
                            }
                        </span>
                        <span class="icons-right">
                            @foreach (var status in slot.StatusBadges)
                            {
                                <span class="badge" title="@status.Name (상태이상)">@noImageSmall</span>
                            }
                        </span>
                    </div>
                </div>
            </div>
        }
    </div>;

    // ADV 대사 한 줄(상자). 나의 대사는 왼쪽에 슬롯 크기의 이미지와 이름 자리가 왼쪽 위에 걸친 텍스트 상자, 상대의 대사는 그 좌우 반전,
    // 일반 텍스트는 상자 없이 글만 나온다.
    RenderFragment<AdvStep> advLine = line => @<text>
        @switch (line.Kind)
        {
            case AdvStepKind.TextMe:
                <div class="adv-line adv-me">
                    <div class="adv-icon">@noImage</div>
                    <div class="adv-box"><span class="adv-name">[ @line.SpeakerName ]</span><p class="adv-text">@((MarkupString)line.Rich.ToHtml())</p></div>
                </div>
                break;
            case AdvStepKind.TextYou:
                <div class="adv-line adv-you">
                    <div class="adv-box"><span class="adv-name">[ @line.SpeakerName ]</span><p class="adv-text">@((MarkupString)line.Rich.ToHtml())</p></div>
                    <div class="adv-icon">@noImage</div>
                </div>
                break;
            case AdvStepKind.TextPlain:
                <div class="adv-line adv-plain">
                    <div class="adv-box"><p class="adv-text">@((MarkupString)line.Rich.ToHtml())</p></div>
                </div>
                break;
            case AdvStepKind.TextLog:
                <p class="adv-normal">@((MarkupString)line.Rich.ToHtml())</p>
                break;
            case AdvStepKind.Chosen:
                <p class="adv-chosen">▶ @((MarkupString)line.Rich.ToHtml())</p>
                break;
        }
    </text>;
}

<main class="game">
    @* 게임팩 고르기와 세이브 고르기 화면도 게임 화면과 같은 960×900 틀을 쓴다: 위쪽 화면 영역 + 맨 아래 한 줄(버튼 또는 코드 입력칸) *@
    @if (pack is null)
    {
        <div class="screen pregame">
            <div class="drop" @ondragenter="() => dragging = true" @ondragleave="() => dragging = false" @ondrop="() => dragging = false"
                 data-dragging="@dragging">
                <p>게임팩(.wra)을 여기에 끌어다 놓으세요</p>
                <InputFile OnChange="OnPackSelected" accept=".wra" />
            </div>
            @if (error is not null)
            {
                <p class="error" role="alert">@error</p>
            }
        </div>
        <footer class="site-footer">
            <a class="button" href="sample-pack.wra" download="sample-pack.wra">기본 게임팩 다운로드</a>
            <button type="button" class="button" @onclick="RunSamplePack">기본 게임팩 실행</button>
        </footer>
    }
    else if (session is null)
    {
        <div class="screen pregame">
            <h1>@pack.Title</h1>
            <div class="drop" @ondragenter="() => dragging = true" @ondragleave="() => dragging = false" @ondrop="() => dragging = false"
                 data-dragging="@dragging">
                <p>세이브(.wsv)를 여기에 끌어다 놓으세요</p>
                <InputFile OnChange="OnSaveSelected" accept=".wsv" />
            </div>
            @if (error is not null)
            {
                <p class="error" role="alert">@error</p>
            }
        </div>
        <footer class="site-footer">
            <button type="button" class="button" @onclick="NewGame">새 게임</button>
        </footer>
    }
    else
    {
        <div class="@(session.Screen == Screen.Interaction ? "screen interaction" : "screen")" @ref="screenArea">
        @switch (session.Screen)
        {
            case Screen.Home:
                @homeSlots(true)
                @* 슬롯 영역 아래: 게임상 날짜와 시간대(턴이 넘어가면 다음 턴의 날짜와 시간대로 바뀐다) *@
                <div class="home-date" aria-label="게임상 날짜와 시간대">@session.CurrentDateText</div>
                @* 구분선으로 나뉜 분류들: [RPG], [정보], [시스템] *@
                @foreach (var group in session.HomeMenu)
                {
                    <div class="menu-separator"></div>
                    <div class="menu-category">[@group.Name]</div>
                    @* 한 줄에 최대 4개씩: 101~104가 한 줄, 105가 다음 줄 *@
                    <div class="menu-grid">@entryList(group.Entries)</div>
                }
                break;

            case Screen.DungeonSelect:
                <h2>던전 선택</h2>
                <ul class="dungeons">
                    @foreach (var d in session.AvailableDungeons)
                    {
                        <li>[@d.Code] @d.Name</li>
                    }
                </ul>
                <div class="dungeon-select">@commands</div>
                break;

            case Screen.PartySetup:
                <h2>파티 설정 : @partyNameButton</h2>
                @partyGrid(false)
                @partyCommands
                break;

            case Screen.EquipmentSetup:
                <h2>파티 설정 : @partyNameButton</h2>
                @partyGrid(true)
                @partyCommands
                break;

            case Screen.LeaderSetup:
                <h2>파티 설정 : @partyNameButton</h2>
                @partyGrid(false)
                @if (session.Message is not null)
                {
                    <p class="message" role="status">@session.Message</p>
                }
                @partyCommands
                break;

            case Screen.SkillSetup:
                <h2>파티 설정 : @partyNameButton</h2>
                @partyGrid(true)
                @partyCommands
                break;

            case Screen.SkillCharacter:
                <h2>@(session.CurrentSlotCharacterName)의 스킬 설정</h2>
                @if (session.CurrentSkillSlots.Count == 0)
                {
                    <p class="end">스킬 슬롯이 없습니다.</p>
                }
                @if (session.Message is not null)
                {
                    <p class="message" role="status">@session.Message</p>
                }
                @* 스킬 슬롯을 순서대로, 구분선 아래에 스킬 풀 *@
                @entryList(session.Entries.Where(e => e.Target == Screen.SkillSlotSelect))
                <div class="menu-separator"></div>
                @entryList(session.Entries.Where(e => e.Target == Screen.SkillPoolList))
                break;

            case Screen.SkillSlotSelect:
                <h2>@(session.CurrentSlotCharacterName)의 @(session.Pack.FindSkillSlot(session.CurrentSkillSlotCode ?? 0)?.Name)</h2>
                @if (session.SlottableSkillRows.Count == 0)
                {
                    <p class="end">장착할 수 있는 스킬이 없습니다.</p>
                }
                @entryList(session.Entries)
                break;

            case Screen.SkillPoolList:
                <h2>@(session.CurrentSlotCharacterName)의 스킬 풀</h2>
                @if (session.SkillPoolRows.Count == 0)
                {
                    <p class="end">익힌 스킬이 없습니다.</p>
                }
                <ul class="companions">
                    @foreach (var r in session.SkillPoolRows)
                    {
                        <li>@(r.Index + 1). @r.Name@(r.EquippedSlotName is null ? "" : $" ({r.EquippedSlotName})")</li>
                    }
                </ul>
                break;

            case Screen.PartyRename:
                <h2>파티 설정 : 이름 변경</h2>
                <p>현재 이름: @session.PartyName</p>
                <p>새 이름을 입력하고 Enter를 누르세요(최대 @(GameSession.MaxPartyNameLength)자).</p>
                @if (session.Message is not null)
                {
                    <p class="message" role="status">@session.Message</p>
                }
                break;

            case Screen.EquipmentList:
                <h2>@(session.CurrentSlotCharacterName)의 장비</h2>
                @if (session.Entries.Count == 1)
                {
                    <p class="end">장비 슬롯이 없습니다.</p>
                }
                @if (session.Message is not null)
                {
                    <p class="message" role="status">@session.Message</p>
                }
                @entryList(session.Entries)
                break;

            case Screen.EquipmentSelect:
                <h2>@(session.CurrentSlotCharacterName)의 @(session.CurrentEquipmentSlot?.Name)</h2>
                @if (session.EquippableItems.Count == 0)
                {
                    <p class="end">장비할 수 있는 장비가 없습니다.</p>
                }
                @entryList(session.Entries)
                break;

            case Screen.SupportSelect:
                <h2>@(session.CurrentSupportRoleName)로 지정할 캐릭터</h2>
                @* 맨 위 [0] 비우기: 이 슬롯에 캐릭터가 있을 때만 나온다. 파티 설정과는 독립이다. *@
                @entryList(session.Entries.Where(e => e.Code == GameSession.ClearEntryCode))
                @* 흰색: 지정 가능, 회색: 보유하지 않음, (이 슬롯의 캐릭터는 목록에 없음), 파란색: 다른 쪽 슬롯의 캐릭터(고르면 서로 바뀐다) *@
                <ul class="character-list">
                    @foreach (var c in session.SupportList)
                    {
                        var supportCode = c.Code.ToString();
                        var supportClass = "char-" + c.Color.ToString().ToLowerInvariant();
                        <li>
                            @if (c.Selectable)
                            {
                                <button class="textlink @supportClass" @onclick="() => Activate(supportCode)">[@c.Code] @c.Name</button>
                            }
                            else
                            {
                                <span class="@supportClass">[@c.Code] @c.Name</span>
                            }
                        </li>
                    }
                </ul>
                break;

            case Screen.CharacterSelect:
                <h2>@((session.CurrentSlot ?? 0) + 1)번 슬롯에 배치할 캐릭터</h2>
                @* 맨 위 [0] 비우기: 이 슬롯에 캐릭터가 있을 때만 나온다. *@
                @entryList(session.Entries.Where(e => e.Code == GameSession.ClearEntryCode))
                @* 흰색: 배치 가능, 회색: 배치 불가, (이 슬롯의 캐릭터는 목록에 없음), 파란색: 이미 배치된 파티원(고르면 위치 교환) *@
                <ul class="character-list">
                    @foreach (var c in session.CharacterList)
                    {
                        var charCode = c.Code.ToString();
                        var colorClass = "char-" + c.Color.ToString().ToLowerInvariant();
                        <li>
                            @if (c.Selectable)
                            {
                                <button class="textlink @colorClass" @onclick="() => Activate(charCode)">[@c.Code] @c.Name</button>
                            }
                            else
                            {
                                <span class="@colorClass">[@c.Code] @c.Name</span>
                            }
                        </li>
                    }
                </ul>
                break;

            case Screen.ShopList:
                <h2>상점</h2>
                <div class="shop-trades">@commands</div>
                break;

            case Screen.ShopTrades:
                <h2>@session.CurrentShop?.Name</h2>
                @if (session.CurrentShopTrades.Count == 0)
                {
                    <p class="end">교환할 수 있는 항목이 없습니다.</p>
                }
                @if (session.Message is not null)
                {
                    <p class="message" role="status">@session.Message</p>
                }
                @* 교환할 수 있는 항목과 돌아가기는 흰색, 지금 교환할 수 없는 항목은 회색(눌러도 반응 없음) *@
                <div class="shop-trades">@commands</div>
                break;

            case Screen.Event:
                <h2>이벤트</h2>
                @if (session.AvailableEvents.Count == 0)
                {
                    <p class="end">지금 일어날 수 있는 이벤트가 없습니다.</p>
                }
                @if (session.Message is not null)
                {
                    <p class="message" role="status">@session.Message</p>
                }
                @commands
                break;

            case Screen.EventPlay:
                @* 선택지가 아닌 장면은 "[1] 다음"을 보여 주지 않고, 아무 키나 누르거나 장면을 누르면 다음으로 넘어간다.
                   같은 ADV의 대사 상자는 지우지 않고 아래로 이어 붙인다(위로 스크롤하면 지난 대사를 볼 수 있다) *@
                <div class="advance-area" @ref="advanceArea" tabindex="@(session.AdvanceOnAnyKey ? 0 : -1)" @onkeydown="OnAdvanceKey" @onclick="OnAdvanceClick">
                    <h2>@session.CurrentStepText</h2>
                    @if (session.CurrentStep is { Kind: EventStepKind.Battle })
                    {
                        <p class="end">전투는 아직 준비되지 않아 바로 다음으로 넘어갑니다.</p>
                    }
                    @* 기본 글자색: 최신 항목은 흰색, 이전 항목은 회색(선택지 목록이 떠 있으면 목록이 최신이다). [color=…]로 정한 색은 그대로다 *@
                    @for (var i = 0; i < session.AdvLog.Count; i++)
                    {
                        var latest = i == session.AdvLog.Count - 1 && session.CurrentAdvStep is not { Kind: AdvStepKind.Choice };
                        <div class="@(latest ? "adv-item" : "adv-item dim")">@advLine(session.AdvLog[i])</div>
                    }
                </div>
                @if (!session.AdvanceOnAnyKey)
                {
                    <div class="adv-choices">@commands</div>
                }
                break;

            case Screen.CommunicationPlay:
                @* 위쪽 슬롯은 그대로 두고(스크롤해도 위에 붙어 있다), 아래를 교류 흐름 재생으로 바꾼다. 재생 방식은 이벤트의 ADV와 같다 *@
                <div class="communication-play">
                    @homeSlots(false)
                    <div class="advance-area" @ref="advanceArea" tabindex="@(session.AdvanceOnAnyKey ? 0 : -1)" @onkeydown="OnAdvanceKey" @onclick="OnAdvanceClick">
                        @for (var i = 0; i < session.AdvLog.Count; i++)
                        {
                            var latest = i == session.AdvLog.Count - 1 && session.CurrentAdvStep is not { Kind: AdvStepKind.Choice };
                            <div class="@(latest ? "adv-item" : "adv-item dim")">@advLine(session.AdvLog[i])</div>
                        }
                    </div>
                    @if (!session.AdvanceOnAnyKey)
                    {
                        <div class="adv-choices">@commands</div>
                    }
                </div>
                break;

            case Screen.Interaction:
                @* 위쪽 슬롯(바꿀 수 없음), 구분선, 아래를 세로로 4등분: 첫째 칸에 교류 그룹 목록, 둘째 칸과의 사이에 세로 구분선 *@
                @homeSlots(false)
                <div class="communication">
                    <div class="communication-groups">@entryList(session.Entries.Where(e => e.Action == EntryAction.SelectCommunicationGroup))</div>
                    <div class="communication-body">@entryList(session.Entries.Where(e => e.Action == EntryAction.StartCommunication))</div>
                </div>
                break;

            case Screen.CompanionCheck:
                <h2>동료 확인</h2>
                @* 지금 가진 캐릭터(당신 포함)를 OrderNumber순, 같으면 인스턴스 ID순으로 *@
                <ul class="companions">
                    @foreach (var r in session.Companions)
                    {
                        @* 코드 칸은 반각 8칸, 이름 칸은 32칸, Lv/Hp/Xp 칸은 8칸씩 고정 너비(ch)라 글꼴에서 한글 폭이 달라도 칸이 맞는다 *@
                        <li><span class="companion-cell" style="width: @(GameSession.CompanionCodeColumns)ch">@r.Order</span> <span class="companion-cell" style="width: @(GameSession.CompanionNameColumns)ch">@r.Name</span> <span class="companion-cell" style="width: @(GameSession.CompanionStatColumns)ch">@r.Level</span> <span class="companion-cell" style="width: @(GameSession.CompanionStatColumns)ch">@r.Hp</span> <span class="companion-cell" style="width: @(GameSession.CompanionStatColumns)ch">@r.Xp</span></li>
                    }
                </ul>
                break;

            case Screen.EquipmentCheck:
                <h2>장비 확인</h2>
                @* 지금 가진 장비(유니크 아이템)를 OrderNumber순, 같으면 인스턴스 ID순으로 "[순서 번호] 이름" *@
                <ul class="companions">
                    @foreach (var e in session.Equipments)
                    {
                        <li><span class="companion-cell" style="width: @(GameSession.CompanionCodeColumns)ch">@e.Order</span> <span class="companion-cell" style="width: @(GameSession.CompanionNameColumns)ch">@e.Name</span></li>
                    }
                </ul>
                break;

            case Screen.ItemCheck:
                <h2>아이템 확인</h2>
                @* 지금 가진 커먼 아이템을 인벤토리 마스터 순서대로 "[아이템 코드] 이름 수량 N" *@
                <ul class="companions">
                    @foreach (var r in session.Items)
                    {
                        <li><span class="companion-cell" style="width: @(GameSession.CompanionCodeColumns)ch">@r.Code</span> <span class="companion-cell" style="width: @(GameSession.CompanionNameColumns)ch">@r.Name</span> <span class="companion-cell" style="width: @(GameSession.ItemAmountColumns)ch">@r.Amount</span></li>
                    }
                </ul>
                break;

            case Screen.Battle:
                <h2>전투(임시)</h2>
                @if (session.CurrentEnemyPartyCode is null)
                {
                    <p class="end">전투 마스터 @(GameSession.TemporaryBattleCode)의 적 파티가 없어 전투를 시작할 수 없습니다.</p>
                }
                else
                {
                    @* 작전 화면: 적 후위, 적 중위, 적 전위, 가운데 영역(경계선), 아군 전위, 아군 중위, 아군 후위 중 다섯 줄(슬롯 네 줄과 가운데 영역)을 한 번에 보여 준다 *@
                    <div class="battle">
                        @foreach (var row in session.BattleRows)
                        {
                            @if (row.Kind == BattleRowKind.Slots)
                            {
                                <div class="battle-row-label">@row.Title</div>
                                <div class="battle-row">
                                    @foreach (var slot in row.Slots)
                                    {
                                        @homeSlot((slot, null))
                                    }
                                </div>
                            }
                            else
                            {
                                @* 가운데 영역: 세 칸의 넓이가 1/3씩이고 사선(30도)으로 나뉜다. 적 파티명은 위쪽 경계선이 없어 적 파티에, 아군 파티명은 아래쪽 경계선이 없어 아군 파티에 속해 보인다 *@
                                <div class="battle-border">
                                    <span class="bb-line-left"></span>
                                    <span class="bb-line-right"></span>
                                    <span class="bb-slash"></span>
                                    <div class="bb-texts">
                                        <span class="bb-text-left">@row.LeftText</span>
                                        <span class="bb-text-center">@row.CenterText</span>
                                        <span class="bb-text-right">@row.RightText</span>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                    @* 구분선 아래: 왼쪽 네 칸 중 세 칸에 커맨드(윗줄 [101]~[103], 아랫줄 [104]~[106]), 윗줄 오른쪽 끝에 구성 전환([1000] ▲, [1001] ▼) *@
                    <div class="battle-commands">
                        <div class="battle-command-list">@entryList(session.Entries.Where(e => e.Action != EntryAction.BattleScroll))</div>
                        <div class="battle-scroll">@entryList(session.Entries.Where(e => e.Action == EntryAction.BattleScroll))</div>
                    </div>
                }
                break;

            case Screen.Debug:
                <h2>디버그</h2>
                @commands
                break;

            case Screen.DebugAddCharacter:
            case Screen.DebugAddEquipment:
            case Screen.DebugAddItem:
                @* 마스터의 전부를 페이지당 20개씩: 항목을 누르면(페이지 안의 번호 [1]~[20]) 하나 추가하고, [101]/[102]로 페이지를 넘긴다 *@
                <h2>@(session.Screen switch { Screen.DebugAddCharacter => "캐릭터 추가", Screen.DebugAddEquipment => "장비 추가", _ => "아이템 추가" })</h2>
                <p class="end">@(session.DebugPage + 1) / @session.DebugPageCount 페이지 (전체 @(session.DebugList.Count)개)</p>
                @if (session.Message is not null)
                {
                    <p class="message" role="status">@session.Message</p>
                }
                @commands
                break;

            case Screen.Load:
                <h2>로드</h2>
                <div class="drop" @ondragenter="() => dragging = true" @ondragleave="() => dragging = false" @ondrop="() => dragging = false"
                     data-dragging="@dragging">
                    <p>세이브(.wsv)를 여기에 끌어다 놓으세요</p>
                    <InputFile OnChange="OnSaveSelected" accept=".wsv" />
                </div>
                @commands
                break;
        }
        @if (error is not null)
        {
            <p class="error" role="alert">@error</p>
        }
        </div>
        @* 돌아가기가 있는 화면이면 코드 입력줄 바로 위 오른쪽에 [999] 돌아가기가 나온다(모든 화면 공통) *@
        @* 교류 화면에서는 같은 줄 왼쪽에 이력(직전 커맨드 < 그전 커맨드 < …)이 나온다 *@
        var back = session.Entries.FirstOrDefault(e => e.Code == GameSession.BackEntryCode);
        var showHistory = session.Screen == Screen.Interaction;
        @if (back is not null || showHistory)
        {
            <div class="@(showHistory ? "back-bar ruled" : "back-bar")">
                @if (showHistory)
                {
                    <span class="history">이력 : @string.Join(" > ", session.CommunicationHistory)</span>
                }
                @if (back is not null)
                {
                    <button class="textlink" @onclick="() => Activate(GameSession.BackEntryCode)">[@back.Code] @back.Label</button>
                }
            </div>
        }
        @* 홈 이후 모든 화면의 맨 아래에 좌우 폭 끝까지 늘 보이는 코드 입력칸 *@
        <div class="command-bar">
            <input @ref="commandInput" class="command" autocomplete="off" placeholder="@CommandPlaceholder"
                   @bind="command" @bind:event="oninput" @onkeydown="OnCommandKey" />
        </div>
    }
</main>

@code {
    const long MaxBytes = 2L * 1024 * 1024 * 1024 - 1;

    GamePack? pack;
    GameSession? session;
    string? error;
    bool dragging;
    string command = "";
    ElementReference commandInput;
    ElementReference advanceArea;
    ElementReference screenArea;
    string? lastScene;
    bool focusCommand;

    /// <summary>슬롯 이름 줄의 CSS 클래스: 리더는 연두색, 전투에서 보고 있는 캐릭터는 파란색(리더여도 파란색).</summary>
    static string SlotNameClass(PartySlotView view) =>
        "slot-name" + (view.IsLeader ? " leader" : "") + (view.IsSelected ? " selected" : "");

    string CommandPlaceholder => session?.Screen switch
    {
        Screen.PartySetup => "슬롯 번호 1~9(왼쪽 위부터)를 입력하고 Enter",
        Screen.PartyRename => "새 파티 이름을 입력하고 Enter",
        _ => "코드를 입력하고 Enter",
    };

    /// <summary>화면이 바뀌었는지 알아보는 표지: 화면, 이벤트 장면, 쌓인 대사 수, 현재 장면.</summary>
    string? SceneKey => session is null ? null
        : $"{session.Screen}|{session.CurrentStep}|{session.AdvLog.Count}|{session.CurrentAdvStep?.FlowNumber}|{session.CurrentAdvStep?.Kind}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // 포커스를 먼저 옮기고(스크롤 없이) 그다음에 스크롤한다: 포커스가 스크롤 위치를 바꾸지 못하게 한다.
        if (focusCommand)
        {
            focusCommand = false;
            if (session is { AdvanceOnAnyKey: true })
                await advanceArea.FocusAsync(preventScroll: true);       // 아무 키나 누르면 넘어가는 장면은 장면 영역이 키를 받는다
            else if (session is { Entries.Count: > 0 } or { Screen: Screen.DungeonSelect })
                await commandInput.FocusAsync(preventScroll: true);
        }

        // 장면이 바뀐 직후에만 스크롤한다(입력칸에 글자를 칠 때마다 다시 그려져도 위로 올려 둔 스크롤은 그대로).
        // 이벤트 진행 화면은 맨 아래(최신 대사)로, 다른 화면은 맨 위로.
        var scene = SceneKey;
        if (scene is not null && scene != lastScene)
            await JS.InvokeVoidAsync("wera.scroll", screenArea, session!.Screen is Screen.EventPlay or Screen.CommunicationPlay);
        lastScene = scene;
    }

    /// <summary>푸터의 "기본 게임팩 실행": 기본 게임팩을 내려받아 올린다(하던 게임은 닫힌다).</summary>
    async Task RunSamplePack()
    {
        error = null;
        try
        {
            var bytes = await Http.GetByteArrayAsync("sample-pack.wra");
            pack = GamePack.Load(new MemoryStream(bytes));
            session = null;
        }
        catch (Exception ex) when (ex is PackFormatException or InvalidDataException or HttpRequestException)
        {
            error = ex is PackFormatException ? ex.Message : "기본 게임팩을 불러올 수 없습니다.";
        }
    }

    async Task OnPackSelected(InputFileChangeEventArgs e)
    {
        error = null;
        if (!e.File.Name.EndsWith(".wra", StringComparison.OrdinalIgnoreCase))
        {
            error = $"게임팩은 .wra 파일이어야 합니다: {e.File.Name}";
            return;
        }
        try
        {
            var ms = new MemoryStream();
            await using (var s = e.File.OpenReadStream(MaxBytes)) await s.CopyToAsync(ms);
            ms.Position = 0;
            pack = GamePack.Load(ms);
        }
        catch (Exception ex) when (ex is PackFormatException or InvalidDataException)
        {
            error = ex is PackFormatException ? ex.Message : "게임팩(.wra) 파일을 읽을 수 없습니다.";
        }
    }

    async Task OnSaveSelected(InputFileChangeEventArgs e)
    {
        error = null;
        if (!e.File.Name.EndsWith(".wsv", StringComparison.OrdinalIgnoreCase))
        {
            error = $"세이브는 .wsv 파일이어야 합니다: {e.File.Name}";
            return;
        }
        try
        {
            using var reader = new StreamReader(e.File.OpenReadStream(16 * 1024 * 1024), Encoding.UTF8);
            session = GameSession.FromSaveJson(pack!, await reader.ReadToEndAsync());
            focusCommand = true;
        }
        catch (SaveFormatException ex) { error = ex.Message; }
    }

    void NewGame() { error = null; session = GameSession.NewGame(pack!); focusCommand = true; }

    async Task Activate(string code)
    {
        error = null;
        var entry = session!.Activate(code);
        if (entry is null) error = $"알 수 없는 입력: {code}";
        else if (entry.Action == EntryAction.Save) await SaveGame();
        command = "";
        focusCommand = true;
    }

    /// <summary>아무 키나 누르면 다음 장면으로(키를 누르고 있어 반복되는 입력과 Shift, Ctrl, Alt, Meta 같은 조합 키만 누른 것은 무시한다).</summary>
    async Task OnAdvanceKey(KeyboardEventArgs e)
    {
        if (session is not { AdvanceOnAnyKey: true } || e.Repeat || e.CtrlKey || e.AltKey || e.MetaKey) return;
        if (e.Key is "Shift" or "Control" or "Alt" or "Meta" or "CapsLock" or "NumLock" or "Tab" or "Escape") return;
        await Activate(GameSession.NextEventStepCode);
    }

    async Task OnAdvanceClick()
    {
        if (session is { AdvanceOnAnyKey: true }) await Activate(GameSession.NextEventStepCode);
    }

    async Task OnCommandKey(KeyboardEventArgs e)
    {
        if (e.Key != "Enter") return;
        // 아무 키나 누르면 넘어가는 장면에서는 비어 있는 입력칸의 Enter도 넘깁니다.
        if (session is { AdvanceOnAnyKey: true } && string.IsNullOrWhiteSpace(command)) await Activate(GameSession.NextEventStepCode);
        else await Activate(command);
    }

    async Task SaveGame() =>
        await JS.InvokeVoidAsync("wera.download", $"{pack!.Id}.wsv", session!.ToSaveJson());

}
