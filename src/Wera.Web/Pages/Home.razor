@page "/"
@using System.Text
@using Wera.Core
@inject IJSRuntime JS
@inject HttpClient Http

<PageTitle>@(pack?.Title ?? "WERA")</PageTitle>

@{
    // 클릭 가능한 텍스트 목록. 항목마다 [코드]가 붙고, 그 코드를 입력해도 같은 동작을 한다.
    // [999] 돌아가기는 목록에 넣지 않는다: 모든 화면에서 같은 자리(코드 입력줄 바로 위 오른쪽)에 따로 나온다.
    RenderFragment<IEnumerable<ScreenEntry>> entryList = entries => @<div class="entries">
        @foreach (var entry in entries.Where(e => e.Code != GameSession.BackEntryCode && e.Action != EntryAction.ListPage))
        {
            var code = entry.Code;
            <div><button class="textlink" disabled="@(!entry.Enabled)" @onclick="() => Activate(code)">[@entry.Code] @if (entry.LabelHtml is { } html) { @((MarkupString)html) } else { @entry.Label }</button></div>
        }
    </div>;

    // 확인 화면 첫 줄의 열 이름: 줄의 칸과 같은 너비(반각 칸 수, ch)로 늘어놓는다.
    RenderFragment<(int[] Widths, IReadOnlyList<string> Names)> columnHead = head => @<text>@for (var i = 0; i < head.Names.Count; i++)
        {
            <span class="companion-cell" style="width: @(head.Widths[i])ch">@head.Names[i]</span>@(i < head.Names.Count - 1 ? " " : "")
        }</text>;

    // 항목(ScreenEntry)을 표로: 첫 줄은 열 이름, 줄마다 [코드]와 값들. 항목을 누르면(또는 코드를 입력하면) 그 항목이 동작하고, 누를 수 없는 항목은 회색이다.
    RenderFragment<TableSpec> entryTable = t => @<ul class="companions">
        <li class="companions-head">@columnHead((t.Widths, t.Heads))</li>
        @{ var rows = t.Entries.ToList(); }
        @foreach (var entry in rows)
        {
            var code = entry.Code;
            var cells = t.Cells(entry);
            <li><button class="textlink row-link" disabled="@(!entry.Enabled)" @onclick="() => Activate(code)">@for (var i = 0; i < cells.Length; i++)
                {
                    <span class="companion-cell" style="width: @(t.Widths[i])ch">@cells[i]</span>@(i < cells.Length - 1 ? " " : "")
                }</button></li>
        }
        @for (var blank = rows.Count; blank < t.PadTo; blank++)
        {
            <li aria-hidden="true"><span class="row-link">&nbsp;</span></li>
        }
    </ul>;

    // 캐릭터 고르기 표(캐릭터 배치, 파트너/어시스트): 맨 위 [0] 비우기 줄(있을 때만), 그다음 지금 페이지의 캐릭터들. 누를 수 없는 캐릭터는 글자만 있고, 색은 목록의 색 규칙을 따른다.
    RenderFragment<(IEnumerable<ScreenEntry> Clear, IEnumerable<CharacterListItem> Items)> characterTable = t => @<ul class="companions">
        <li class="companions-head">@columnHead((new[] { GameSession.CompanionCodeColumns, GameSession.CompanionNameColumns }, new[] { "#", "이름" }))</li>
        @foreach (var clear in t.Clear)
        {
            var clearCode = clear.Code;
            <li><button class="textlink row-link" @onclick="() => Activate(clearCode)"><span class="companion-cell" style="width: @(GameSession.CompanionCodeColumns)ch">[@clear.Code]</span> <span class="companion-cell" style="width: @(GameSession.CompanionNameColumns)ch">@clear.Label</span></button></li>
        }
        @foreach (var (c, number) in t.Items.Select((item, i) => (item, i + 1)))
        {
            var pickCode = number.ToString();
            var colorClass = "char-" + c.Color.ToString().ToLowerInvariant();
            <li>
                @if (c.Selectable)
                {
                    <button class="textlink row-link @colorClass" @onclick="() => Activate(pickCode)"><span class="companion-cell" style="width: @(GameSession.CompanionCodeColumns)ch">[@number]</span> <span class="companion-cell" style="width: @(GameSession.CompanionNameColumns)ch">@c.Name</span></button>
                }
                else
                {
                    <span class="row-link @colorClass"><span class="companion-cell" style="width: @(GameSession.CompanionCodeColumns)ch">[@number]</span> <span class="companion-cell" style="width: @(GameSession.CompanionNameColumns)ch">@c.Name</span></span>
                }
            </li>
        }
    </ul>;

    /// <summary>항목의 라벨을 " : "에서 둘로 나눈다(슬롯 이름 : 낀 것). 없으면 라벨 전체와 빈 칸.</summary>
    static string[] SplitLabel(ScreenEntry e)
    {
        var i = e.Label.IndexOf(" : ", StringComparison.Ordinal);
        return i < 0 ? [e.Label, ""] : [e.Label[..i], e.Label[(i + 3)..]];
    }

    /// <summary>목록에 나오는 항목들: 돌아가기와 페이지 버튼은 표에 넣지 않는다.</summary>
    IEnumerable<ScreenEntry> ListEntries(Func<ScreenEntry, bool>? filter = null) =>
        session!.Entries.Where(e => e.Code != GameSession.BackEntryCode && e.Action != EntryAction.ListPage && (filter?.Invoke(e) ?? true));

    /// <summary>던전 맵 한 칸의 CSS 클래스: 플레이어 표시, 칸의 표시용 효과들(벽, 계단 등), 이동불가.</summary>
    static string DungeonCellClass(DungeonCellView cell)
    {
        if (cell.IsPlayer) return "dcell dplayer";
        if (cell.Text == "") return "dcell dvoid";
        var classes = new List<string> { "dcell" };
        if (cell.Look.HasFlag(DungeonCellLook.Wall)) classes.Add("dwall");
        if (cell.Look.HasFlag(DungeonCellLook.Stairs)) classes.Add("dstairs");
        if (cell.Look.HasFlag(DungeonCellLook.Exit)) classes.Add("dexit");
        if (cell.Look.HasFlag(DungeonCellLook.Battle)) classes.Add("dbattle");
        if (cell.Look.HasFlag(DungeonCellLook.Adv)) classes.Add("dadv");
        if (cell.Look.HasFlag(DungeonCellLook.Warp)) classes.Add("dwarp");
        if (cell.Look.HasFlag(DungeonCellLook.Event)) classes.Add("devent");
        return string.Join(' ', classes);
    }

    // 파티 설정 화면 아래: 구분선, 파티 선택 버튼([11] 파티-A ~ [26] 파티-P, 한 줄에 4개씩), 모드 버튼([101] 캐릭터 배치, [102] 장비 착용)을 4분할 위치에 가로로.
    // 지금 보는 파티와 지금 모드의 버튼은 파란색으로 눌리지 않고, 고를 수 있는 다른 것은 흰색이다.
    RenderFragment partyCommands = @<div class="party-commands">
        @if (!session!.IsHideoutPartyEdit)
        {
            <div class="party-select">@entryList(session.Entries.Where(e => e.Action == EntryAction.SelectParty))</div>
        }
        <div class="party-modes">@entryList(session!.Entries.Where(e => e.Action == EntryAction.Navigate && e.Arg is null && e.Target != Screen.Home))</div>
    </div>;

    // 파티 설정 화면 제목의 "[0] 파티명": 누르면(또는 0을 입력하면) 파티 이름을 바꾼다.
    // 아지트의 방어 파티를 편집하는 중에는 이름(층 이름)을 바꿀 수 없어 글자만 나온다.
    RenderFragment partyNameButton = @<text>@if (session!.IsHideoutPartyEdit) { <span>@session.PartyName</span> } else { <button class="textlink" @onclick="() => Activate(GameSession.RenamePartyEntryCode)">[@GameSession.RenamePartyEntryCode] @session.PartyName</button> }</text>;

    RenderFragment commands = @<div class="commands">
        @entryList(session!.Entries)
    </div>;

    // 속성 아이콘 이미지 리소스가 없을 때(지금은 항상) 쓰는 1줄 높이의 작은 기본 이미지.
    RenderFragment noImageSmall = @<svg class="badge-icon" viewBox="0 0 10 10" role="img" aria-label="No Image">
        <rect x="0.5" y="0.5" width="9" height="9" fill="#000" stroke="#666" />
    </svg>;

    // 캐릭터 이미지 리소스가 없을 때(지금은 항상) 쓰는 기본 이미지.
    RenderFragment noImage = @<svg class="no-image" viewBox="0 0 100 100" role="img" aria-label="No Image">
        <rect x="1" y="1" width="98" height="98" fill="#000" stroke="#666" stroke-width="2" />
        <text x="50" y="55" text-anchor="middle" font-size="15" fill="#999" font-family="monospace">No Image</text>
    </svg>;

    // 이미지 마스터에 이미지가 있으면 그림을, 없으면 No Image 기본 이미지를 그리는 슬롯 크기의 이미지(대상 코드가 없으면 늘 기본 이미지).
    RenderFragment<(ImageKind Kind, long? Target, long Variation)> pic = i => @<text>@if (ImageUrl(i.Kind, i.Target, i.Variation) is { } url) { <img class="no-image" src="@url" alt="" /> } else { @noImage }</text>;

    // 1줄 높이의 작은 아이콘(속성, 상태이상)용: 이미지가 있으면 그림, 없으면 작은 No Image.
    RenderFragment<(ImageKind Kind, long Target)> smallPic = i => @<text>@if (ImageUrl(i.Kind, i.Target, 0) is { } url) { <img class="badge-icon" src="@url" alt="" /> } else { @noImageSmall }</text>;

    // 상세 화면의 큰 이미지 칸(300×600): 이미지가 있으면 그림, 없으면 No Image 글자 칸.
    RenderFragment<(ImageKind Kind, long Target)> detailPic = i => @<text>@if (ImageUrl(i.Kind, i.Target, 0) is { } url) { <img class="char-image" src="@url" alt="" /> } else { <div class="char-image" role="img" aria-label="No Image">No Image</div> }</text>;

    // 홈 화면 위쪽의 슬롯(당신, 파트너, 어시스트): 파티 슬롯과 같은 모양. 코드가 있으면 이미지나 이름을 눌러(또는 그 코드를 입력해)
    // 캐릭터 목록으로 가고, 코드가 없으면(당신) 눌러도 아무 일도 없다.
    RenderFragment<(PartySlotView View, string? Code)> homeSlot = item => @<div class="slot">
        @if (item.Code is { } homeCode)
        {
            <button class="slot-icon" title="@item.View.Name" @onclick="() => Activate(homeCode)">@pic((ImageKind.Character, item.View.CharacterCode, 0L))</button>
        }
        else
        {
            <div class="slot-icon" title="@item.View.Name">@pic((ImageKind.Character, item.View.CharacterCode, 0L))</div>
        }
        <div class="slot-info">
            @if (item.Code is { } nameCode)
            {
                <button class="@SlotNameClass(item.View)" @onclick="() => Activate(nameCode)">
                    <span class="slot-level">@item.View.LevelText</span><span class="slot-char">@item.View.Name</span>
                </button>
            }
            else
            {
                <div class="@SlotNameClass(item.View)"><span class="slot-level">@item.View.LevelText</span><span class="slot-char">@item.View.Name</span></div>
            }
            <div class="gauge-line">HP  : <span class="gauge gauge-@item.View.Hp.Color.ToString().ToLowerInvariant()">@item.View.Hp.Text</span></div>
            <div class="gauge-line"><XpLabelView Tag="@item.View.XpTag" /><span class="gauge gauge-@item.View.Xp.Color.ToString().ToLowerInvariant()">@item.View.Xp.Text</span></div>
            <div class="icon-line">
                <span class="icons-left">
                    @foreach (var badge in item.View.Badges)
                    {
                        <span class="badge" title="@badge.Name (@(badge.Advantage ? "유리속성" : "불리속성"))">@smallPic((ImageKind.Attribute, badge.AttributeCode))<span class="badge-marker">@badge.Marker</span></span>
                    }
                </span>
                <span class="icons-right">
                    @foreach (var status in item.View.StatusBadges)
                    {
                        <span class="badge" title="@status.Name (상태이상)">@smallPic((ImageKind.StatusEffect, status.StatusEffectCode))</span>
                    }
                </span>
            </div>
        </div>
    </div>;

    // 당신, 파트너, 어시스트 슬롯 줄(홈 화면과 교류 화면 위쪽). 눌러서 바꿀 수 있는 것은 홈 화면뿐이라 교류 화면에서는 interactive가 false다.
    RenderFragment<bool> homeSlots = interactive => @<div class="home-slots">
        <div>
            <div class="row-label">@GameSession.PlayerSlotName</div>
            @homeSlot((session!.PlayerSlot, null))
        </div>
        <div>
            <div class="row-label">@(interactive ? $"[{GameSession.PartnerEntryCode}] " : "")파트너</div>
            @homeSlot((session!.PartnerSlot, interactive ? GameSession.PartnerEntryCode : null))
        </div>
        <div>
            <div class="row-label">@(interactive ? $"[{GameSession.AssistEntryCode}] " : "")어시스트</div>
            @homeSlot((session!.AssistSlot, interactive ? GameSession.AssistEntryCode : null))
        </div>
    </div>;

    // 파티 슬롯 3×3. 위 줄이 전위, 가운데 줄이 중위, 아래 줄이 후위. 이름이나 아이콘을 누르면(또는 슬롯 번호를 입력하면)
    // 캐릭터 배치 모드에서는 배치할 캐릭터 목록으로, 장비 착용 모드에서는 그 캐릭터의 장비 목록으로 간다.
    // 장비 착용 모드에서는 빈 슬롯을 누를 수 없다.
    RenderFragment<bool> partyGrid = equipmentMode => @<div class="party-grid">
        @foreach (var slot in session!.PartySlotViews)
        {
            var slotCode = (slot.Slot + 1).ToString();
            var enabled = session.Entries.Any(e => e.Code == slotCode && e.Enabled);      // 화면마다 고를 수 있는 슬롯이 다르다
            @if (slot.Slot % 3 == 0)
            {
                <div class="row-label">@slot.RowName</div>
            }
            <div class="slot" data-slot="@slotCode">
                <button class="slot-icon" title="@slot.Name" disabled="@(!enabled)" @onclick="() => Activate(slotCode)">@pic((ImageKind.Character, slot.CharacterCode, 0L))</button>
                <div class="slot-info">
                    @* "Lv.XX            [x] 이름"(레벨은 왼쪽, "[x] 이름"은 줄 오른쪽 끝; 빈 슬롯은 레벨 자리가 빔): [x]는 슬롯 번호이고 입력해도 고를 수 있다 *@
                    <button class="@("slot-name" + (slot.IsLeader ? " leader" : "") + (slot.IsUnavailable ? " unavailable" : ""))" disabled="@(!enabled)" @onclick="() => Activate(slotCode)">
                        <span class="slot-level">@slot.LevelText</span><span class="slot-char">[@slotCode] @slot.Name</span>
                    </button>
                    <div class="gauge-line">HP  : <span class="gauge gauge-@slot.Hp.Color.ToString().ToLowerInvariant()">@slot.Hp.Text</span></div>
                    <div class="gauge-line"><XpLabelView Tag="@slot.XpTag" /><span class="gauge gauge-@slot.Xp.Color.ToString().ToLowerInvariant()">@slot.Xp.Text</span></div>
                    <div class="icon-line">
                        <span class="icons-left">
                            @foreach (var badge in slot.Badges)
                            {
                                <span class="badge" title="@badge.Name (@(badge.Advantage ? "유리속성" : "불리속성"))">@smallPic((ImageKind.Attribute, badge.AttributeCode))<span class="badge-marker">@badge.Marker</span></span>
                            }
                        </span>
                        <span class="icons-right">
                            @foreach (var status in slot.StatusBadges)
                            {
                                <span class="badge" title="@status.Name (상태이상)">@smallPic((ImageKind.StatusEffect, status.StatusEffectCode))</span>
                            }
                        </span>
                    </div>
                </div>
            </div>
        }
    </div>;

    // 아지트: 한 번에 3개 층을 보여 주는 3×3. 줄마다 왼쪽이 계층("[4] 1층", 맨 위 줄은 "[1] 확장 가능"), 가운데가 시설("공터", 아직 정의되지 않음),
    // 오른쪽이 보스 슬롯(캐릭터 한 명, 비면 "미지정")이다. 층이 없는 줄은 "----"이다.
    RenderFragment hideoutGrid = @<div class="party-grid hideout-grid">
        @foreach (var row in session!.HideoutRows)
        {
            var floorCode = row.FloorCode.ToString();
            var bossCode = row.BossCode.ToString();
            var facilityCode = row.FacilityCode.ToString();
            <div class="slot">
                <div class="slot-icon" title="@row.FloorName">@noImage</div>
                <div class="slot-info">
                    @if (row.IsExpandRow)
                    {
                        <button class="slot-name" @onclick="() => Activate(floorCode)"><span class="slot-level"></span><span class="slot-char">[@floorCode] @row.FloorName</span></button>
                    }
                    else if (row.IsEmpty)
                    {
                        <div class="slot-name gray"><span class="slot-level"></span><span class="slot-char">----</span></div>
                    }
                    else
                    {
                        <button class="slot-name" @onclick="() => Activate(floorCode)"><span class="slot-level"></span><span class="slot-char">[@floorCode] @row.FloorName</span></button>
                    }
                </div>
            </div>
            <div class="slot">
                <div class="slot-icon" title="@row.FacilityName">@pic((ImageKind.Facility, row.BuiltFacilityCode, 0L))</div>
                <div class="slot-info">
                    @if (row.Floor is >= 0 && session.Entries.Any(e => e.Code == facilityCode))
                    {
                        <button class="slot-name" @onclick="() => Activate(facilityCode)"><span class="slot-level"></span><span class="slot-char">[@facilityCode] @row.FacilityName</span></button>
                    }
                    else
                    {
                        <div class="slot-name @(row.Floor is >= 0 ? "" : "gray")"><span class="slot-level"></span><span class="slot-char">@(row.Floor is >= 0 ? $"[{row.FacilityCode}] {row.FacilityName}" : "----")</span></div>
                    }
                </div>
            </div>
            @if (row.Boss is { } boss)
            {
                <div class="slot">
                    <button class="slot-icon" title="@boss.Name" @onclick="() => Activate(bossCode)">@pic((ImageKind.Character, boss.CharacterCode, 0L))</button>
                    <div class="slot-info">
                        <button class="@("slot-name" + (boss.IsUnavailable ? " unavailable" : ""))" @onclick="() => Activate(bossCode)">
                            <span class="slot-level">@boss.LevelText</span><span class="slot-char">[@bossCode] @(boss.IsEmpty ? "미지정" : boss.Name)</span>
                        </button>
                        <div class="gauge-line">HP  : <span class="gauge gauge-@boss.Hp.Color.ToString().ToLowerInvariant()">@boss.Hp.Text</span></div>
                        <div class="gauge-line"><XpLabelView Tag="@boss.XpTag" /><span class="gauge gauge-@boss.Xp.Color.ToString().ToLowerInvariant()">@boss.Xp.Text</span></div>
                    </div>
                </div>
            }
            else
            {
                <div class="slot"><div class="slot-icon">@noImage</div><div class="slot-info"><div class="slot-name gray"><span class="slot-level"></span><span class="slot-char">----</span></div></div></div>
            }
        }
    </div>;

    // ADV 대사 한 줄(상자). 나의 대사는 왼쪽에 슬롯 크기의 이미지와 이름 자리가 왼쪽 위에 걸친 텍스트 상자, 상대의 대사는 그 좌우 반전,
    // 일반 텍스트는 상자 없이 글만 나온다.
    RenderFragment<AdvStep> advLine = line => @<text>
        @switch (line.Kind)
        {
            case AdvStepKind.TextMe:
                <div class="adv-line adv-me">
                    <div class="adv-icon">@pic((ImageKind.Character, line.CharacterCode, line.Variation))</div>
                    <div class="adv-box"><span class="adv-name">[ @line.SpeakerName ]</span><p class="adv-text">@((MarkupString)line.Rich.ToHtml())</p></div>
                </div>
                break;
            case AdvStepKind.TextYou:
                <div class="adv-line adv-you">
                    <div class="adv-box"><span class="adv-name">[ @line.SpeakerName ]</span><p class="adv-text">@((MarkupString)line.Rich.ToHtml())</p></div>
                    <div class="adv-icon">@pic((ImageKind.Character, line.CharacterCode, line.Variation))</div>
                </div>
                break;
            case AdvStepKind.TextPlain:
                <div class="adv-line adv-plain">
                    <div class="adv-box"><p class="adv-text">@((MarkupString)line.Rich.ToHtml())</p></div>
                </div>
                break;
            case AdvStepKind.TextLog:
                <p class="adv-normal">@((MarkupString)line.Rich.ToHtml())</p>
                break;
            case AdvStepKind.Chosen:
                <p class="adv-chosen">▶ @((MarkupString)line.Rich.ToHtml())</p>
                break;
        }
    </text>;
}

<main class="game">
    @* 게임팩 고르기와 세이브 고르기 화면도 게임 화면과 같은 960×900 틀을 쓴다: 위쪽 화면 영역 + 맨 아래 한 줄(버튼 또는 코드 입력칸) *@
    @if (pack is null)
    {
        <div class="screen pregame">
            <div class="drop" @ondragenter="() => dragging = true" @ondragleave="() => dragging = false" @ondrop="() => dragging = false"
                 data-dragging="@dragging">
                <p>게임팩(.wra)을 여기에 끌어다 놓으세요</p>
                <InputFile OnChange="OnPackSelected" accept=".wra" />
            </div>
            @if (error is not null)
            {
                <p class="error" role="alert">@error</p>
            }
        </div>
        <footer class="site-footer">
            <a class="button" href="sample-pack.wra" download="sample-pack.wra">기본 게임팩 다운로드</a>
            <button type="button" class="button" @onclick="RunSamplePack">기본 게임팩 실행</button>
        </footer>
    }
    else if (session is null)
    {
        <div class="screen pregame">
            <h1>@pack.Title</h1>
            <div class="drop" @ondragenter="() => dragging = true" @ondragleave="() => dragging = false" @ondrop="() => dragging = false"
                 data-dragging="@dragging">
                <p>세이브(.wsv)를 여기에 끌어다 놓으세요</p>
                <InputFile OnChange="OnSaveSelected" accept=".wsv" />
            </div>
            @if (error is not null)
            {
                <p class="error" role="alert">@error</p>
            }
        </div>
        <footer class="site-footer">
            <button type="button" class="button" @onclick="NewGame">새 게임</button>
        </footer>
    }
    else
    {
        <div class="@(session.Screen switch { Screen.Interaction => "screen interaction", Screen.DungeonMove => "screen dungeon-move", Screen.CharacterDetail => "screen char-detail-page", _ => "screen" })" @ref="screenArea">
        @switch (session.Screen)
        {
            case Screen.Home:
                @homeSlots(true)
                @* 슬롯 영역 아래: 게임상 날짜와 시간대(턴이 넘어가면 다음 턴의 날짜와 시간대로 바뀐다) *@
                <div class="home-date" aria-label="게임상 날짜와 시간대">@session.CurrentDateText</div>
                @* 구분선으로 나뉜 분류들: [RPG], [정보], [시스템] *@
                @foreach (var group in session.HomeMenu)
                {
                    <div class="menu-separator"></div>
                    <div class="menu-category">[@group.Name]</div>
                    @* 한 줄에 최대 4개씩: 101~104가 한 줄, 105가 다음 줄 *@
                    <div class="menu-grid">@entryList(group.Entries)</div>
                }
                break;

            case Screen.DungeonSelect:
                <h2>던전 선택</h2>
                <div class="dungeon-select">@entryTable(new TableSpec(ListEntries(), CodeNameWidths, ["#", "던전"], e => ["[" + e.Code + "]", e.Label]))</div>
                break;

            case Screen.DungeonPartySelect:
                <h2>파티 선택</h2>
                <div class="dungeon-select">@entryTable(new TableSpec(ListEntries(), CodeNameWidths, ["#", "파티"], e => ["[" + e.Code + "]", e.Label]))</div>
                break;

            case Screen.DungeonMove:
                @* 던전 맵: 칸마다 맵 TSV의 글자를 그리고(칸 폭은 전각 한 글자), 현재 위치는 @로 덮는다. 벽, 계단, 출구, 전투, ADV, 이동 칸은 색으로 구분한다 *@
                @* 왼쪽은 맵(가로 30칸 × 2 = 반각 60칸), 세로 구분선, 오른쪽에는 맵 이름, 층 이름, 스테이터스 확인, 아이템 확인, 세이브 *@
                @* 맵은 30줄, 그 아래 가로 구분선, 그 밑은 로그 영역. 세로 구분선은 입력칸 위까지 이어진다 *@
                <div class="dungeon-layout">
                    <div class="dungeon-left">
                        <div class="dungeon-map">
                            @foreach (var row in session.DungeonMapRows)
                            {
                                <div class="dungeon-row">
                                    @foreach (var cell in row)
                                    {
                                        <span class="@DungeonCellClass(cell)">@(cell.IsPlayer ? "@" : cell.Text)</span>
                                    }
                                </div>
                            }
                        </div>
                        <div class="dungeon-log"></div>
                    </div>
                    <div class="dungeon-side">
                        <div class="dungeon-name">@session.DungeonName</div>
                        <div class="dungeon-layer">@session.DungeonLayerName</div>
                        @commands
                    </div>
                </div>
                break;

            case Screen.GameOver:
                <h2>GAME OVER</h2>
                <div class="dungeon-moves">@commands</div>
                break;

            case Screen.PartySetup:
                <h2>파티 설정 : @partyNameButton</h2>
                @partyGrid(false)
                @partyCommands
                break;

            case Screen.EquipmentSetup:
                <h2>파티 설정 : @partyNameButton</h2>
                @partyGrid(true)
                @partyCommands
                break;

            case Screen.LeaderSetup:
                <h2>파티 설정 : @partyNameButton</h2>
                @partyGrid(false)
                @if (session.Message is not null)
                {
                    <p class="message" role="status">@session.Message</p>
                }
                @partyCommands
                break;

            case Screen.SkillSetup:
                <h2>파티 설정 : @partyNameButton</h2>
                @partyGrid(true)
                @partyCommands
                break;

            case Screen.SkillCharacter:
                <h2>@(session.CurrentSlotCharacterName)의 스킬 설정</h2>
                @if (session.CurrentSkillSlots.Count == 0)
                {
                    <p class="end">스킬 슬롯이 없습니다.</p>
                }
                @if (session.Message is not null)
                {
                    <p class="message" role="status">@session.Message</p>
                }
                @* 스킬 슬롯을 순서대로, 구분선 아래에 스킬 풀 *@
                @entryTable(new TableSpec(ListEntries(e => e.Target == Screen.SkillSlotSelect), SlotWidths, ["#", "슬롯", "스킬"], e => ["[" + e.Code + "]", .. SplitLabel(e)]))
                <div class="menu-separator"></div>
                @entryList(session.Entries.Where(e => e.Target == Screen.SkillPoolList))
                break;

            case Screen.SkillSlotSelect:
                <h2>@(session.CurrentSlotCharacterName)의 @(session.Pack.FindSkillSlot(session.CurrentSkillSlotCode ?? 0)?.Name)</h2>
                @if (session.SlottableSkillRows.Count == 0)
                {
                    <p class="end">장착할 수 있는 스킬이 없습니다.</p>
                }
                @entryTable(new TableSpec(ListEntries(), CodeNameWidths, ["#", "이름"], e => ["[" + e.Code + "]", e.Label]))
                break;

            case Screen.SkillPoolList:
                <h2>@(session.CurrentSlotCharacterName)의 스킬 풀</h2>
                @if (session.SkillPoolRows.Count == 0)
                {
                    <p class="end">익힌 스킬이 없습니다.</p>
                }
                <ul class="companions">
                    <li class="companions-head">@columnHead((SlotWidths, new[] { "#", "이름", "장착" }))</li>
                    @foreach (var (r, number) in session.PageOf(session.SkillPoolRows).Select((row, i) => (row, i + 1)))
                    {
                        <li><span class="row-link"><span class="companion-cell" style="width: @(SlotWidths[0])ch">@number</span> <span class="companion-cell" style="width: @(SlotWidths[1])ch">@r.Name</span> <span class="companion-cell" style="width: @(SlotWidths[2])ch">@r.EquippedSlotName</span></span></li>
                    }
                </ul>
                break;

            case Screen.PartyRename:
                <h2>파티 설정 : 이름 변경</h2>
                <p>현재 이름: @session.PartyName</p>
                <p>새 이름을 입력하고 Enter를 누르세요(최대 @(GameSession.MaxPartyNameLength)자).</p>
                @if (session.Message is not null)
                {
                    <p class="message" role="status">@session.Message</p>
                }
                break;

            case Screen.EquipmentList:
                <h2>@(session.CurrentSlotCharacterName)의 장비</h2>
                @if (session.CurrentEquipmentSlots.Count == 0)
                {
                    <p class="end">장비 슬롯이 없습니다.</p>
                }
                @if (session.Message is not null)
                {
                    <p class="message" role="status">@session.Message</p>
                }
                @entryTable(new TableSpec(ListEntries(), SlotWidths, ["#", "슬롯", "장비"], e => ["[" + e.Code + "]", .. SplitLabel(e)]))
                break;

            case Screen.EquipmentSelect:
                <h2>@(session.CurrentSlotCharacterName)의 @(session.CurrentEquipmentSlot?.Name)</h2>
                @if (session.EquippableItems.Count == 0)
                {
                    <p class="end">장비할 수 있는 장비가 없습니다.</p>
                }
                @entryTable(new TableSpec(ListEntries(), CodeNameWidths, ["#", "이름"], e => ["[" + e.Code + "]", e.Label]))
                break;

            case Screen.SupportSelect:
                <h2>@(session.CurrentSupportRoleName)로 지정할 캐릭터</h2>
                @* 맨 위 [0] 비우기: 이 슬롯에 캐릭터가 있을 때만 나온다. 파티 설정과는 독립이다. *@
                @* 흰색: 지정 가능, 회색: 보유하지 않음, (이 슬롯의 캐릭터는 목록에 없음), 파란색: 다른 쪽 슬롯의 캐릭터(고르면 서로 바뀐다) *@
                @characterTable((session.Entries.Where(e => e.Code == GameSession.ClearEntryCode), session.PageOf(session.SupportList)))
                break;

            case Screen.CharacterSelect:
                <h2>@((session.CurrentSlot ?? 0) + 1)번 슬롯에 배치할 캐릭터</h2>
                @* 맨 위 [0] 비우기: 이 슬롯에 캐릭터가 있을 때만 나온다. *@
                @* 흰색: 배치 가능, 회색: 배치 불가, (이 슬롯의 캐릭터는 목록에 없음), 파란색: 이미 배치된 파티원(고르면 위치 교환) *@
                @characterTable((session.Entries.Where(e => e.Code == GameSession.ClearEntryCode), session.PageOf(session.CharacterList)))
                break;

            case Screen.ShopList:
                <h2>상점</h2>
                <div class="shop-trades">@entryTable(new TableSpec(ListEntries(), CodeNameWidths, ["#", "상점"], e => ["[" + e.Code + "]", e.Label]))</div>
                break;

            case Screen.ShopTrades:
                <h2>@session.CurrentShop?.Name</h2>
                @if (session.CurrentShopTrades.Count == 0)
                {
                    <p class="end">교환할 수 있는 항목이 없습니다.</p>
                }
                @if (session.Message is not null)
                {
                    <p class="message" role="status">@session.Message</p>
                }
                @* 교환할 수 있는 항목은 흰색, 지금 교환할 수 없는 항목은 회색(눌러도 반응 없음) *@
                <div class="shop-trades">@entryTable(new TableSpec(ListEntries(), CodeNameWidths, ["#", "교환"], e => ["[" + e.Code + "]", e.Label]))</div>
                break;

            case Screen.Hideout:
                <h2>@(session.CurrentHideoutName is { } hideoutName ? $"아지트: {hideoutName}" : "아지트")</h2>
                @if (session.Message is not null)
                {
                    <p class="message" role="status">@session.Message</p>
                }
                @hideoutGrid
                <div class="menu-separator"></div>
                <div class="battle-scroll">@entryList(session.Entries.Where(e => e.Action == EntryAction.HideoutScroll))</div>
                <div class="commands">@entryList(session.Entries.Where(e => e.Action != EntryAction.HideoutScroll && e.Code is GameSession.BackEntryCode or GameSession.FacilityCheckEntryCode))</div>
                break;

            case Screen.FacilityCheck:
                <h2>@(session.CurrentHideoutName is { } checkHideoutName ? $"시설 확인: {checkHideoutName}" : "시설 확인")</h2>
                @* 읽기만 하는 화면: 층마다 기본 시설, 지은 시설의 오퍼레이터와 방어력, 생산 내용 *@
                <div class="facility-check">
                    @foreach (var line in session.FacilityCheckLines)
                    {
                        <div class="@(line.Indent == 0 ? "facility-check-floor" : null)" style="@($"padding-left:{line.Indent * 1.5}em;white-space:pre-wrap")">@line.Text</div>
                    }
                </div>
                @commands
                break;

            case Screen.HideoutExpand:
                <h2>아지트 확장 (@(session.HideoutFloorCount + 1)층째)</h2>
                @* 쓸 재료 그룹을 고른다: 그룹 안은 모두, 그룹끼리는 하나만 갖추면 된다(갖추지 못한 그룹은 회색) *@
                @commands
                break;

            case Screen.HideoutFloorDetail:
                <h2>@(session.CurrentHideoutFacilityFloorName)</h2>
                <p>@session.HideoutFloorDetailText</p>
                @commands
                break;

            case Screen.HideoutFacilityDetail:
                <h2>@(session.CurrentHideoutFacilityFloorName) 시설</h2>
                <p>@session.HideoutFacilityDetailText</p>
                @* 철거하면 재료는 돌려받을 수 없다 *@
                @commands
                break;

            case Screen.HideoutFacilitySelect:
                <h2>@(session.CurrentHideoutFacilityFloorName)에 지을 시설</h2>
                @* 설치 조건을 만족한 시설만 나온다(재료를 갖추지 못한 시설은 회색) *@
                @commands
                break;

            case Screen.HideoutBuild:
                <h2>@(session.SelectedFacilityName) 건설</h2>
                @* 쓸 재료 그룹을 고른다: 그룹 안은 모두, 그룹끼리는 하나만 갖추면 된다(갖추지 못한 그룹은 회색) *@
                @commands
                break;

            case Screen.HideoutOperatorSelect:
                <h2>@(session.CurrentHideoutOperatorTitle)</h2>
                @* 슬롯의 태그 조건을 만족하는 캐릭터만 나온다. 파란색: 이미 아지트에 있는 캐릭터(고르면 옮겨 온다), 흰색: 파티원(고르면 파티에서 빠진다)과 나머지 *@
                @characterTable((session.Entries.Where(e => e.Code == GameSession.ClearEntryCode), session.PageOf(session.SupportList)))
                break;


            case Screen.EquipmentEnhance:
                <h2>장비 강화</h2>
                @if (session.Message is not null)
                {
                    <p class="message" role="status">@session.Message</p>
                }
                @* 위는 가진 장비 표(누르면 장비 상세)로, 항목이 적어도 20줄 자리를 비워 두어 구분선과 합성/제련/개조의 위치가 늘 같다. 구분선 아래는 합성/제련/개조 *@
                @entryTable(new TableSpec(ListEntries(e => e.Code is not (GameSession.SynthesisEntryCode or GameSession.SmeltEntryCode or GameSession.ModifyEntryCode)), CodeNameWidths, [.. GameSession.EquipmentColumnNames], e => [e.Code, e.Label], session.ListPageSize))
                <div class="menu-separator"></div>
                @* 고른 작업(합성/제련/개조)은 굵게 보인다 *@
                <div class="menu-grid"><div class="entries">
                    @foreach (var e in session.Entries.Where(e => e.Code is GameSession.SynthesisEntryCode or GameSession.SmeltEntryCode or GameSession.ModifyEntryCode))
                    {
                        var code = e.Code;
                        var chosen = session.EnhanceMode?.ToString() == e.Arg;
                        <div><button class="textlink @(chosen ? "chosen" : "")" disabled="@(!e.Enabled)" @onclick="() => Activate(code)">[@e.Code] @e.Label</button></div>
                    }
                </div></div>
                break;

            case Screen.EquipmentEnhanceTarget:
                @* 개조: 장비 상세처럼 보이고, 부품 슬롯 자리에 개조 슬롯 줄이 있어 누르면 끼울 아이템 목록으로 간다 *@
                @if (session.EquipmentDetail is { } mod)
                {
                    <h2>개조</h2>
                    @if (session.Message is not null)
                    {
                        <p class="message" role="status">@session.Message</p>
                    }
                    <div class="char-detail">
                        @detailPic((ImageKind.UniqueItem, mod.ItemCode))
                        <div class="char-info">
                            <div class="char-head"><span class="char-name">@mod.Name</span><span class="char-level">@mod.EnhanceText</span></div>
                            <hr />
                            <div class="char-columns">
                                @foreach (var line in mod.Specs)
                                {
                                    <div>@line.Label : @line.Value</div>
                                }
                            </div>
                            <hr />
                            <div class="char-columns">
                                @foreach (var (line, entry) in mod.Parts.Zip(session.Entries))
                                {
                                    var code = entry.Code;
                                    <div><button class="textlink row-link" disabled="@(!entry.Enabled)" @onclick="() => Activate(code)">[@entry.Code] @line.Label : @line.Value</button></div>
                                }
                            </div>
                            <hr />
                            <div class="char-columns">
                                @foreach (var line in mod.Skills)
                                {
                                    <div>@line.Label : @line.Value</div>
                                }
                            </div>
                            <hr />
                            <p class="char-description">@mod.Description</p>
                        </div>
                    </div>
                }
                @entryList(session.Entries.Where(e => e.Code == GameSession.BackEntryCode))
                break;

            case Screen.EquipmentModSlot:
                <h2>개조: @session.EquipmentName(session.EnhanceTargetId)</h2>
                <p>@(session.ModSlotCode is { } modSlot ? session.ModSlotName(modSlot) : "")에 끼울 아이템을 고르세요.</p>
                @commands
                break;

            case Screen.Event:
                <h2>이벤트</h2>
                @if (session.AvailableEvents.Count == 0)
                {
                    <p class="end">지금 일어날 수 있는 이벤트가 없습니다.</p>
                }
                @if (session.Message is not null)
                {
                    <p class="message" role="status">@session.Message</p>
                }
                @entryTable(new TableSpec(ListEntries(), CodeNameWidths, ["#", "이벤트"], e => ["[" + e.Code + "]", e.Label]))
                break;

            case Screen.EventPlay:
                @* 선택지가 아닌 장면은 "[1] 다음"을 보여 주지 않고, 아무 키나 누르거나 장면을 누르면 다음으로 넘어간다.
                   같은 ADV의 대사 상자는 지우지 않고 아래로 이어 붙인다(위로 스크롤하면 지난 대사를 볼 수 있다) *@
                <div class="advance-area" @ref="advanceArea" tabindex="@(session.AdvanceOnAnyKey ? 0 : -1)" @onkeydown="OnAdvanceKey" @onclick="OnAdvanceClick">
                    <h2>@session.CurrentStepText</h2>
                    @* 기본 글자색: 최신 항목은 흰색, 이전 항목은 회색(선택지 목록이 떠 있으면 목록이 최신이다). [color=…]로 정한 색은 그대로다 *@
                    @for (var i = 0; i < session.AdvLog.Count; i++)
                    {
                        var latest = i == session.AdvLog.Count - 1 && session.CurrentAdvStep is not { Kind: AdvStepKind.Choice };
                        <div class="@(latest ? "adv-item" : "adv-item dim")">@advLine(session.AdvLog[i])</div>
                    }
                </div>
                @if (!session.AdvanceOnAnyKey)
                {
                    <div class="adv-choices">@commands</div>
                }
                break;

            case Screen.Defense:
                @* 방어전: 결과 로그를 한 줄씩 보여 준다. 이벤트 장면처럼 아무 키나 누르거나 눌러서 다음 줄로 넘어간다(마지막 다음은 홈으로) *@
                <div class="advance-area" @ref="advanceArea" tabindex="0" @onkeydown="OnAdvanceKey" @onclick="OnAdvanceClick">
                    <h2>아지트 방어전</h2>
                    @for (var i = 0; i < session.DefenseLog.Count; i++)
                    {
                        <div class="@(i == session.DefenseLog.Count - 1 ? "adv-item" : "adv-item dim")">@session.DefenseLog[i]</div>
                    }
                </div>
                break;

            case Screen.CommunicationPlay:
                @* 위쪽 슬롯은 그대로 두고(스크롤해도 위에 붙어 있다), 아래를 교류 흐름 재생으로 바꾼다. 재생 방식은 이벤트의 ADV와 같다 *@
                <div class="communication-play">
                    @homeSlots(false)
                    <div class="advance-area" @ref="advanceArea" tabindex="@(session.AdvanceOnAnyKey ? 0 : -1)" @onkeydown="OnAdvanceKey" @onclick="OnAdvanceClick">
                        @for (var i = 0; i < session.AdvLog.Count; i++)
                        {
                            var latest = i == session.AdvLog.Count - 1 && session.CurrentAdvStep is not { Kind: AdvStepKind.Choice };
                            <div class="@(latest ? "adv-item" : "adv-item dim")">@advLine(session.AdvLog[i])</div>
                        }
                    </div>
                    @if (!session.AdvanceOnAnyKey)
                    {
                        <div class="adv-choices">@commands</div>
                    }
                </div>
                break;

            case Screen.Interaction:
                @* 위쪽 슬롯(바꿀 수 없음), 구분선, 아래를 세로로 4등분: 첫째 칸에 교류 그룹 목록, 둘째 칸과의 사이에 세로 구분선 *@
                @homeSlots(false)
                <div class="communication">
                    <div class="communication-groups">@entryList(session.Entries.Where(e => e.Action == EntryAction.SelectCommunicationGroup))</div>
                    <div class="communication-body">@entryList(session.Entries.Where(e => e.Action == EntryAction.StartCommunication))</div>
                </div>
                break;

            case Screen.StatusCheck:
                <h2>스테이터스 확인</h2>
                @* 보는 파티의 슬롯(파티 설정과 같은 3×3). 캐릭터가 있는 슬롯을 고르면 캐릭터 상세 화면으로 간다 *@
                @partyGrid(true)
                break;

            case Screen.CharacterDetail:
                @* 캐릭터 상세: 좌측 하단에 250×750 이미지 칸, 오른쪽에 이름/레벨, Exp 바, HP/XPP, 상태값(미정), 장비, 스킬, 설명문을 구분선으로 나눠 놓는다 *@
                @if (session.CharacterDetail is { } detail)
                {
                    <h2>캐릭터 상세</h2>
                    <div class="char-detail">
                        @detailPic((ImageKind.Character, detail.CharacterCode))
                        <div class="char-info">
                            <div class="char-head"><span class="char-name">@detail.Name</span><span class="char-level">@detail.LevelText</span></div>
                            <div class="gauge-line">Exp : <span class="gauge gauge-@detail.Exp.Color.ToString().ToLowerInvariant()">@detail.Exp.Text</span></div>
                            <hr />
                            <div class="gauge-line">HP  : <span class="gauge gauge-@detail.Hp.Color.ToString().ToLowerInvariant()">@detail.Hp.Text</span></div>
                            <div class="gauge-line"><XpLabelView Tag="@detail.XpTag" /><span class="gauge gauge-@detail.Xp.Color.ToString().ToLowerInvariant()">@detail.Xp.Text</span></div>
                            <hr />
                            <div class="char-columns">
                                @foreach (var line in detail.Specs)
                                {
                                    <div>@line.Label : @line.Value</div>
                                }
                            </div>
                            <hr />
                            <div class="char-columns">
                                @foreach (var (line, entry) in detail.Equipment.Zip(session.Entries))
                                {
                                    var code = entry.Code;
                                    <div><button class="textlink row-link" disabled="@(!entry.Enabled)" @onclick="() => Activate(code)">@line.Label : @line.Value</button></div>
                                }
                            </div>
                            <hr />
                            <div class="char-columns">
                                @foreach (var (line, entry) in detail.Skills.Zip(session.Entries.Skip(detail.Equipment.Count)))
                                {
                                    var code = entry.Code;
                                    <div><button class="textlink row-link" disabled="@(!entry.Enabled)" @onclick="() => Activate(code)">@line.Label : @line.Value</button></div>
                                }
                            </div>
                            <hr />
                            <p class="char-description">@detail.Description</p>
                        </div>
                    </div>
                }
                break;

            case Screen.EquipmentDetail:
                @* 장비 상세: 왼쪽에 이미지 칸, 오른쪽에 장비명/+강화 횟수, HP/XP(낀 캐릭터와 공유), 상태값, 부품 슬롯, 스킬, 설명문을 구분선으로 나눠 놓는다 *@
                @if (session.EquipmentDetail is { } equip)
                {
                    <h2>장비 상세</h2>
                    <div class="char-detail">
                        @detailPic((ImageKind.UniqueItem, equip.ItemCode))
                        <div class="char-info">
                            <div class="char-head"><span class="char-name">@equip.Name</span><span class="char-level">@equip.EnhanceText</span></div>
                            <hr />
                            <div class="gauge-line">HP  : <span class="gauge gauge-@equip.Hp.Color.ToString().ToLowerInvariant()">@equip.Hp.Text</span></div>
                            <div class="gauge-line"><XpLabelView Tag="@equip.XpTag" /><span class="gauge gauge-@equip.Xp.Color.ToString().ToLowerInvariant()">@equip.Xp.Text</span></div>
                            <hr />
                            <div class="char-columns">
                                @foreach (var line in equip.Specs)
                                {
                                    <div>@line.Label : @line.Value</div>
                                }
                            </div>
                            <hr />
                            <div class="char-columns">
                                @foreach (var (line, entry) in equip.Parts.Zip(session.Entries))
                                {
                                    var code = entry.Code;
                                    <div><button class="textlink row-link" disabled="@(!entry.Enabled)" @onclick="() => Activate(code)">@line.Label : @line.Value</button></div>
                                }
                            </div>
                            <hr />
                            <div class="char-columns">
                                @foreach (var (line, entry) in equip.Skills.Zip(session.Entries.Skip(equip.Parts.Count)))
                                {
                                    var code = entry.Code;
                                    <div><button class="textlink row-link" disabled="@(!entry.Enabled)" @onclick="() => Activate(code)">@line.Label : @line.Value</button></div>
                                }
                            </div>
                            <hr />
                            <p class="char-description">@equip.Description</p>
                        </div>
                    </div>
                }
                break;

            case Screen.ItemDetail:
                @* 아이템 상세: 왼쪽에 이미지 칸, 오른쪽에 아이템명/수량, 소지 한도와 스킬, 설명문을 구분선으로 나눠 놓는다 *@
                @if (session.ItemDetail is { } itemView)
                {
                    <h2>아이템 상세</h2>
                    <div class="char-detail">
                        @detailPic((ImageKind.CommonItem, itemView.ItemCode))
                        <div class="char-info">
                            <div class="char-head"><span class="char-name">@itemView.Name</span><span class="char-level">@itemView.AmountText</span></div>
                            <hr />
                            <div class="char-columns">
                                <div>소지 한도 : @itemView.CarryLimit</div>
                                @foreach (var (line, entry) in itemView.Skills.Zip(session.Entries))
                                {
                                    var code = entry.Code;
                                    <div><button class="textlink row-link" disabled="@(!entry.Enabled)" @onclick="() => Activate(code)">@line.Label : @line.Value</button></div>
                                }
                            </div>
                            <hr />
                            <p class="char-description">@itemView.Description</p>
                        </div>
                    </div>
                }
                break;

            case Screen.SkillDetail:
                @* 스킬 상세: 왼쪽에 이미지 칸, 오른쪽에 스킬명, 대상, 설명문을 구분선으로 나눠 놓는다 *@
                @if (session.SkillDetail is { } skillView)
                {
                    <h2>스킬 상세</h2>
                    <div class="char-detail">
                        @detailPic((ImageKind.Skill, skillView.SkillCode))
                        <div class="char-info">
                            <div class="char-head"><span class="char-name">@skillView.Name</span></div>
                            <hr />
                            <div class="char-columns"><div>대상 : @skillView.Target</div></div>
                            <hr />
                            <p class="char-description">@skillView.Description</p>
                        </div>
                    </div>
                }
                break;

            case Screen.CompanionCheck:
                <h2>동료 확인</h2>
                @* 지금 가진 캐릭터(당신 포함)를 OrderNumber순, 같으면 인스턴스 ID순으로. 줄을 누르면(또는 번호를 입력하면) 캐릭터 상세 화면으로 간다 *@
                <ul class="companions">
                    @* 첫 줄은 열 이름(#, 이름, 레벨, 체력, XP): 줄과 같은 칸 너비에 눌러도 아무 일이 없는 글자다 *@
                    <li class="companions-head">@columnHead((new[] { GameSession.CompanionCodeColumns, GameSession.CompanionNameColumns, GameSession.CompanionStatColumns, GameSession.CompanionStatColumns, GameSession.CompanionStatColumns }, GameSession.CompanionColumnNames))</li>
                    @foreach (var (r, entry) in session.PageOf(session.Companions).Zip(session.Entries))
                    {
                        var code = entry.Code;
                        @* 코드 칸은 반각 8칸, 이름 칸은 32칸, Lv/Hp/Xpp 칸은 8칸씩 고정 너비(ch)라 글꼴에서 한글 폭이 달라도 칸이 맞는다 *@
                        <li><button class="textlink row-link" @onclick="() => Activate(code)"><span class="companion-cell" style="width: @(GameSession.CompanionCodeColumns)ch">[@entry.Code]</span> <span class="companion-cell" style="width: @(GameSession.CompanionNameColumns)ch">@r.Name</span> <span class="companion-cell" style="width: @(GameSession.CompanionStatColumns)ch">@r.Level</span> <span class="companion-cell" style="width: @(GameSession.CompanionStatColumns)ch">@r.Hp</span> <span class="companion-cell" style="width: @(GameSession.CompanionStatColumns)ch">@r.Xpp</span></button></li>
                    }
                </ul>
                break;

            case Screen.EquipmentCheck:
                <h2>장비 확인</h2>
                @* 지금 가진 장비(유니크 아이템)를 OrderNumber순, 같으면 인스턴스 ID순으로 "[순서 번호] 이름". 줄을 누르면 장비 상세 화면으로 간다 *@
                <ul class="companions">
                    <li class="companions-head">@columnHead((new[] { GameSession.CompanionCodeColumns, GameSession.CompanionNameColumns }, GameSession.EquipmentColumnNames))</li>
                    @foreach (var (e, entry) in session.PageOf(session.Equipments).Zip(session.Entries))
                    {
                        var code = entry.Code;
                        <li><button class="textlink row-link" @onclick="() => Activate(code)"><span class="companion-cell" style="width: @(GameSession.CompanionCodeColumns)ch">[@entry.Code]</span> <span class="companion-cell" style="width: @(GameSession.CompanionNameColumns)ch">@e.Name</span></button></li>
                    }
                </ul>
                break;

            case Screen.ItemCheck:
                <h2>아이템 확인</h2>
                @* 지금 가진 커먼 아이템을 인벤토리 마스터 순서대로 "[아이템 코드] 이름 수량 N". 줄을 누르면 아이템 상세 화면으로 간다 *@
                <ul class="companions">
                    <li class="companions-head">@columnHead((new[] { GameSession.CompanionCodeColumns, GameSession.CompanionNameColumns, GameSession.ItemAmountColumns }, GameSession.ItemColumnNames))</li>
                    @foreach (var (r, entry) in session.PageOf(session.Items).Zip(session.Entries))
                    {
                        var code = entry.Code;
                        <li><button class="textlink row-link" @onclick="() => Activate(code)"><span class="companion-cell" style="width: @(GameSession.CompanionCodeColumns)ch">[@entry.Code]</span> <span class="companion-cell" style="width: @(GameSession.CompanionNameColumns)ch">@r.Name</span> <span class="companion-cell" style="width: @(GameSession.ItemAmountColumns)ch">@r.Amount</span></button></li>
                    }
                </ul>
                break;

            case Screen.Battle:
                <h2>전투</h2>
                @if (session.CurrentEnemyPartyCode is null)
                {
                    <p class="end">이 전투에 나올 적 파티가 없습니다.</p>
                }
                else
                {
                    @* 작전 화면: 적 후위, 적 중위, 적 전위, 가운데 영역(경계선), 아군 전위, 아군 중위, 아군 후위 중 다섯 줄(슬롯 네 줄과 가운데 영역)을 한 번에 보여 준다 *@
                    <div class="battle">
                        @foreach (var row in session.BattleRows)
                        {
                            @if (row.Kind == BattleRowKind.Slots)
                            {
                                <div class="battle-row-label">@row.Title</div>
                                <div class="battle-row">
                                    @foreach (var slot in row.Slots)
                                    {
                                        @* 슬롯 번호(적 [1]~[9], 아군 [11]~[19])가 이름 앞에 붙고, 이미지나 번호를 누르면 상태 확인 페이지로(대상을 고를 때는 대상 선택) 간다 *@
                                        var number = GameSession.BattleSlotNumber(row.IsEnemy, slot.Slot);
                                        var clickable = session.Entries.Any(e => e.Code == number);       @* 빈 칸도 교체할 자리로는 고를 수 있다 *@
                                        @homeSlot((slot.IsEmpty ? slot : slot with { Name = $"[{number}] {slot.Name}" }, clickable ? number : null))
                                    }
                                </div>
                            }
                            else
                            {
                                @* 가운데 영역: 세 칸의 넓이가 1/3씩이고 사선(30도)으로 나뉜다. 적 파티명은 위쪽 경계선이 없어 적 파티에, 아군 파티명은 아래쪽 경계선이 없어 아군 파티에 속해 보인다 *@
                                <div class="battle-border">
                                    <span class="bb-line-left"></span>
                                    <span class="bb-line-right"></span>
                                    <span class="bb-slash"></span>
                                    <div class="bb-texts">
                                        <span class="bb-text-left">@row.LeftText</span>
                                        <span class="bb-text-center">@row.CenterText</span>
                                        <span class="bb-text-right">@row.RightText</span>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                    @if (session.BattleLogLines.Count > 0)
                    {
                        <ul class="battle-log">
                            @foreach (var line in session.BattleLogLines)
                            {
                                <li>@line</li>
                            }
                        </ul>
                    }
                    @if (session.BattleOutcome != GameSession.BattleOutcomeKind.None)
                    {
                        <p class="end">@(session.BattleOutcome switch { GameSession.BattleOutcomeKind.Win => "전투에서 승리했습니다!", GameSession.BattleOutcomeKind.Lose => "전투에서 패배했습니다...", _ => "전투에서 도망쳤습니다." })</p>
                    }
                    @if (session.BattleDropLines.Count > 0)
                    {
                        <p class="end">획득: @string.Join(", ", session.BattleDropLines)</p>
                    }
                    @* 구분선 아래: 왼쪽 네 칸 중 세 칸에 커맨드(윗줄 [101]~[103], 아랫줄 [104]~[106]), 윗줄 오른쪽 끝에 구성 전환([1000] ▲, [1001] ▼) *@
                    <div class="battle-commands">
                        <div class="battle-command-list @(session.BattleCommands == GameSession.BattleCommandMode.Basic ? "battle-command-basic" : "")">@entryList(session.Entries.Where(e => e.Action != EntryAction.BattleScroll && e.Action != EntryAction.BattleViewUnit && e.Action != EntryAction.BattleChooseTarget && e.Action != EntryAction.BattleMoveTo))</div>
                        <div class="battle-scroll">@entryList(session.Entries.Where(e => e.Action == EntryAction.BattleScroll))</div>
                    </div>
                }
                break;

            case Screen.UnitStatus:
                @if (session.UnitStatus is { } unitStatus)
                {
                    <h2>@unitStatus.Name <span class="slot-level">@unitStatus.LevelText</span></h2>
                    <div class="gauge-line">HP  : <span class="gauge gauge-@unitStatus.Hp.Color.ToString().ToLowerInvariant()">@unitStatus.Hp.Text</span></div>
                    <div class="gauge-line"><XpLabelView Tag="@unitStatus.XpTag" /><span class="gauge gauge-@unitStatus.Xp.Color.ToString().ToLowerInvariant()">@unitStatus.Xp.Text</span></div>
                    <h3>스테이터스</h3>
                    <ul class="companions">
                        @foreach (var line in unitStatus.Statuses)
                        {
                            <li><span class="companion-cell" style="width: @(GameSession.CompanionNameColumns)ch">@line.Label</span> <span class="companion-cell">@line.Value</span></li>
                        }
                    </ul>
                    <h3>장비</h3>
                    <ul class="companions">
                        @foreach (var line in unitStatus.Equipment)
                        {
                            <li><span class="companion-cell" style="width: @(GameSession.CompanionNameColumns)ch">@line.Label</span> <span class="companion-cell">@line.Value</span></li>
                        }
                    </ul>
                    <h3>스킬</h3>
                    <ul class="companions">
                        @foreach (var line in unitStatus.Skills)
                        {
                            <li><span class="companion-cell" style="width: @(GameSession.CompanionNameColumns)ch">@line.Label</span> <span class="companion-cell">@line.Value</span></li>
                        }
                    </ul>
                }
                else
                {
                    <p class="end">캐릭터를 찾을 수 없습니다.</p>
                }
                break;

            case Screen.Debug:
                <h2>디버그</h2>
                @commands
                break;

            case Screen.DebugAddCharacter:
            case Screen.DebugAddEquipment:
            case Screen.DebugAddItem:
            case Screen.DebugSkillCharacter:
            case Screen.DebugAddSkill:
                @* 마스터의 전부를 페이지당 20개씩 표로: 항목을 누르면(페이지 안의 번호 [1]~[20]) 하나 추가하고, 하단의 페이지 버튼으로 페이지를 넘긴다 *@
                <h2>@(session.Screen switch { Screen.DebugAddCharacter => "캐릭터 추가", Screen.DebugAddEquipment => "장비 추가", Screen.DebugSkillCharacter => "스킬 추가 : 캐릭터 선택", Screen.DebugAddSkill => "스킬 추가", _ => "아이템 추가" })</h2>
                <p class="end">@(session.DebugPage + 1) / @session.DebugPageCount 페이지 (전체 @(session.DebugList.Count)개)</p>
                @if (session.Message is not null)
                {
                    <p class="message" role="status">@session.Message</p>
                }
                @entryTable(new TableSpec(ListEntries(), CodeNameWidths, ["#", "이름 (코드)"], e => ["[" + e.Code + "]", e.Label]))
                break;

            case Screen.Load:
                <h2>로드</h2>
                <div class="drop" @ondragenter="() => dragging = true" @ondragleave="() => dragging = false" @ondrop="() => dragging = false"
                     data-dragging="@dragging">
                    <p>세이브(.wsv)를 여기에 끌어다 놓으세요</p>
                    <InputFile OnChange="OnSaveSelected" accept=".wsv" />
                </div>
                @commands
                break;
        }
        @if (error is not null)
        {
            <p class="error" role="alert">@error</p>
        }
        </div>
        @* 돌아가기가 있는 화면이면 코드 입력줄 바로 위 오른쪽에 [999] 돌아가기가 나온다(모든 화면 공통) *@
        @* 교류 화면에서는 같은 줄 왼쪽에 이력(직전 커맨드 < 그전 커맨드 < …)이 나온다 *@
        var back = session.Entries.FirstOrDefault(e => e.Code == GameSession.BackEntryCode);
        var showHistory = session.Screen == Screen.Interaction;
        @* 목록 화면이 한 페이지(20개)를 넘으면 같은 줄 왼쪽에 페이지 버튼이 나온다: [101] 1 ... [102] N-2 [103] N-1 N [104] N+1 [105] N+2 ... [106] 마지막 *@
        var pager = session.Pager;
        @if (back is not null || showHistory || pager.Count > 0)
        {
            <div class="@(showHistory ? "back-bar ruled" : "back-bar")">
                @if (pager.Count > 0)
                {
                    <span class="pager">
                        @foreach (var b in pager)
                        {
                            var pageCode = b.Code;
                            @if (b.Current)
                            {
                                <span class="pager-current">@b.Text</span>
                            }
                            else if (pageCode is null)
                            {
                                <span>@b.Text</span>
                            }
                            else
                            {
                                <button class="textlink" @onclick="() => Activate(pageCode, typed: true)">[@pageCode] @b.Text</button>
                            }
                        }
                    </span>
                }
                @if (showHistory)
                {
                    <span class="history">이력 : @string.Join(" > ", session.CommunicationHistory)</span>
                }
                @if (back is not null)
                {
                    <button class="textlink" @onclick="() => Activate(GameSession.BackEntryCode)">[@back.Code] @back.Label</button>
                }
            </div>
        }
        @* 홈 이후 모든 화면의 맨 아래에 좌우 폭 끝까지 늘 보이는 코드 입력칸 *@
        <div class="command-bar">
            @if (session.Screen == Screen.DungeonMove)
            {
                @* 던전 이동: 글을 쓰지 않고 키만 받는다(W A S D는 누르는 즉시 이동, Enter는 지금 칸의 상호작용) *@
                <input @ref="commandInput" class="command" autocomplete="off" placeholder="W A S D 이동, Enter 상호작용"
                       value="" @oninput="OnDungeonInput" @onkeydown="OnDungeonKey" />
            }
            else
            {
                <input @ref="commandInput" class="command" autocomplete="off" placeholder="@CommandPlaceholder"
                       @bind="command" @bind:event="oninput" @onkeydown="OnCommandKey" />
            }
        </div>
    }
</main>

@code {
    // 이미지 URL: 게임팩이 가진 이미지를 data URL로 바꿔 이미지(바이트)마다 한 번만 만들어 둔다(같은 이미지를 가리키는 대상은 같은 문자열을 쓴다).
    static readonly System.Runtime.CompilerServices.ConditionalWeakTable<ImageData, string> imageUrls = new();

    string? ImageUrl(ImageKind kind, long? target, long variation)
    {
        if (target is not { } code || session is null || session.Pack.ImageFor(kind, code, variation) is not { } data) return null;
        return imageUrls.GetValue(data, d => $"data:{d.Mime};base64,{Convert.ToBase64String(d.Bytes)}");
    }

    /// <summary>항목 표 한 개: 줄이 될 항목들, 칸 너비(반각 칸 수), 열 이름, 항목에서 칸의 글자들을 만드는 함수.</summary>
    record TableSpec(IEnumerable<ScreenEntry> Entries, int[] Widths, string[] Heads, Func<ScreenEntry, string[]> Cells, int PadTo = 0);

    static readonly int[] CodeNameWidths = [GameSession.CompanionCodeColumns, GameSession.CompanionNameColumns];
    static readonly int[] SlotWidths = [GameSession.CompanionCodeColumns, 24, GameSession.CompanionNameColumns];

    const long MaxBytes = 2L * 1024 * 1024 * 1024 - 1;

    GamePack? pack;
    GameSession? session;
    string? error;
    bool dragging;
    string command = "";
    ElementReference commandInput;
    ElementReference advanceArea;
    ElementReference screenArea;
    string? lastScene;
    bool focusCommand;

    /// <summary>슬롯 이름 줄의 CSS 클래스: 리더는 연두색, 전투에서 보고 있는 캐릭터는 파란색(리더여도 파란색).</summary>
    static string SlotNameClass(PartySlotView view) =>
        "slot-name" + (view.IsLeader ? " leader" : "") + (view.IsSelected ? " selected" : "") + (view.IsGray ? " gray" : "");

    string CommandPlaceholder => session?.Screen switch
    {
        Screen.PartySetup => "슬롯 번호 1~9(왼쪽 위부터)를 입력하고 Enter",
        Screen.PartyRename => "새 파티 이름을 입력하고 Enter",
        _ => "코드를 입력하고 Enter",
    };

    /// <summary>화면이 바뀌었는지 알아보는 표지: 화면, 이벤트 장면, 쌓인 대사 수, 현재 장면.</summary>
    string? SceneKey => session is null ? null
        : $"{session.Screen}|{session.CurrentStep}|{session.AdvLog.Count}|{session.CurrentAdvStep?.FlowNumber}|{session.CurrentAdvStep?.Kind}|{session.DefenseLog.Count}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // 포커스를 먼저 옮기고(스크롤 없이) 그다음에 스크롤한다: 포커스가 스크롤 위치를 바꾸지 못하게 한다.
        if (focusCommand)
        {
            focusCommand = false;
            if (session is { AdvanceOnAnyKey: true })
                await advanceArea.FocusAsync(preventScroll: true);       // 아무 키나 누르면 넘어가는 장면은 장면 영역이 키를 받는다
            else if (session is { Entries.Count: > 0 } or { Screen: Screen.DungeonSelect or Screen.DungeonMove })
                await commandInput.FocusAsync(preventScroll: true);
        }

        // 장면이 바뀐 직후에만 스크롤한다(입력칸에 글자를 칠 때마다 다시 그려져도 위로 올려 둔 스크롤은 그대로).
        // 이벤트 진행 화면은 맨 아래(최신 대사)로, 다른 화면은 맨 위로.
        var scene = SceneKey;
        if (scene is not null && scene != lastScene)
            await JS.InvokeVoidAsync("wera.scroll", screenArea, session!.Screen is Screen.EventPlay or Screen.CommunicationPlay or Screen.Defense);
        lastScene = scene;
    }

    /// <summary>푸터의 "기본 게임팩 실행": 기본 게임팩을 내려받아 올린다(하던 게임은 닫힌다).</summary>
    async Task RunSamplePack()
    {
        error = null;
        try
        {
            var bytes = await Http.GetByteArrayAsync("sample-pack.wra");
            pack = GamePack.Load(new MemoryStream(bytes));
            session = null;
        }
        catch (Exception ex) when (ex is PackFormatException or InvalidDataException or HttpRequestException)
        {
            error = ex is PackFormatException ? ex.Message : "기본 게임팩을 불러올 수 없습니다.";
        }
    }

    async Task OnPackSelected(InputFileChangeEventArgs e)
    {
        error = null;
        if (!e.File.Name.EndsWith(".wra", StringComparison.OrdinalIgnoreCase))
        {
            error = $"게임팩은 .wra 파일이어야 합니다: {e.File.Name}";
            return;
        }
        try
        {
            var ms = new MemoryStream();
            await using (var s = e.File.OpenReadStream(MaxBytes)) await s.CopyToAsync(ms);
            ms.Position = 0;
            pack = GamePack.Load(ms);
        }
        catch (Exception ex) when (ex is PackFormatException or InvalidDataException)
        {
            error = ex is PackFormatException ? ex.Message : "게임팩(.wra) 파일을 읽을 수 없습니다.";
        }
    }

    async Task OnSaveSelected(InputFileChangeEventArgs e)
    {
        error = null;
        if (!e.File.Name.EndsWith(".wsv", StringComparison.OrdinalIgnoreCase))
        {
            error = $"세이브는 .wsv 파일이어야 합니다: {e.File.Name}";
            return;
        }
        try
        {
            using var reader = new StreamReader(e.File.OpenReadStream(16 * 1024 * 1024), Encoding.UTF8);
            session = GameSession.FromSaveJson(pack!, await reader.ReadToEndAsync());
            focusCommand = true;
        }
        catch (SaveFormatException ex) { error = ex.Message; }
    }

    void NewGame() { error = null; session = GameSession.NewGame(pack!); focusCommand = true; }

    /// <param name="typed">입력칸에 쓴 코드면 true, 눌러서 고른 항목이면 false(항목 코드가 페이지 버튼 코드 101~106과 겹치면 눌렀을 때는 항목, 입력했을 때는 페이지 버튼이 먼저다). 페이지 버튼을 누를 때는 true.</param>
    async Task Activate(string code, bool typed = false)
    {
        error = null;
        var entry = session!.Activate(code, typed);
        if (entry is null) error = $"알 수 없는 입력: {code}";
        else if (entry.Action == EntryAction.Save) await SaveGame();
        command = "";
        focusCommand = true;
    }

    /// <summary>아무 키나 누르면 다음 장면으로(키를 누르고 있어 반복되는 입력과 Shift, Ctrl, Alt, Meta 같은 조합 키만 누른 것은 무시한다).</summary>
    async Task OnAdvanceKey(KeyboardEventArgs e)
    {
        if (session is not { AdvanceOnAnyKey: true } || e.Repeat || e.CtrlKey || e.AltKey || e.MetaKey) return;
        if (e.Key is "Shift" or "Control" or "Alt" or "Meta" or "CapsLock" or "NumLock" or "Tab" or "Escape") return;
        await Activate(GameSession.NextEventStepCode);
    }

    async Task OnAdvanceClick()
    {
        if (session is { AdvanceOnAnyKey: true }) await Activate(GameSession.NextEventStepCode);
    }

    /// <summary>방금 keydown이 이동 키를 처리했다(그 키의 input 이벤트는 글자만 지운다. 한글 입력기가 켜져 있어도 키 위치(Code)로 처리하기 위해서다).</summary>
    bool dungeonKeyHandled;

    async Task OnDungeonInput(ChangeEventArgs e)
    {
        if (!dungeonKeyHandled)                       // keydown이 키를 알려 주지 못한 입력(모바일 자판 등)은 글자로 처리한다
            foreach (var key in e.Value?.ToString() ?? "") session!.PressDungeonKey(key);
        dungeonKeyHandled = false;
        await JS.InvokeVoidAsync("wera.clearInput", commandInput);
        focusCommand = true;
    }

    void OnDungeonKey(KeyboardEventArgs e)
    {
        dungeonKeyHandled = false;
        switch (e.CtrlKey || e.AltKey || e.MetaKey ? "" : e.Code)
        {
            case "KeyW": session!.PressDungeonKey('w'); dungeonKeyHandled = true; break;
            case "KeyS": session!.PressDungeonKey('s'); dungeonKeyHandled = true; break;
            case "KeyA": session!.PressDungeonKey('a'); dungeonKeyHandled = true; break;
            case "KeyD": session!.PressDungeonKey('d'); dungeonKeyHandled = true; break;
        }
        switch (e.Key)
        {
            case "Enter": session!.InteractDungeon(); break;
            case "ArrowUp": session!.PressDungeonKey('w'); break;
            case "ArrowDown": session!.PressDungeonKey('s'); break;
            case "ArrowLeft": session!.PressDungeonKey('a'); break;
            case "ArrowRight": session!.PressDungeonKey('d'); break;
        }
        focusCommand = true;
    }

    async Task OnCommandKey(KeyboardEventArgs e)
    {
        if (e.Key != "Enter") return;
        // 아무 키나 누르면 넘어가는 장면에서는 비어 있는 입력칸의 Enter도 넘깁니다.
        if (session is { AdvanceOnAnyKey: true } && string.IsNullOrWhiteSpace(command)) await Activate(GameSession.NextEventStepCode);
        else await Activate(command, typed: true);
    }

    async Task SaveGame() =>
        await JS.InvokeVoidAsync("wera.download", $"{pack!.Id}.wsv", session!.ToSaveJson());

}
